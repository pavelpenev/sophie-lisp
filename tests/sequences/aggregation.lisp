;;;; Independent Chapter 6 forcing oracles; no production helper dependencies.
(in-package #:sophie-lisp.tests)

(defun f1-uncached-keys (function)
  ;; Arithmetic oracle, independent of the chosen comparison algorithm.
  (let* ((input (loop for n downfrom 257 above 0 collect n))
         (keys 0) (comparisons 0) (pending nil) (paired t)
         (result
           (funcall function input
             :key (lambda (x) (incf keys) (push x pending) x)
             :test (lambda (a b)
                     (incf comparisons)
                     (unless (and (= 2 (length pending))
                                  (equal (sort (copy-list pending) #'<)
                                         (sort (list a b) #'<)))
                       (setf paired nil))
                     (setf pending nil)
                     (< a b)))))
    (parachute:is equal (loop for n from 1 to 257 collect n) result)
    (parachute:true (plusp comparisons))
    (parachute:is = (* 2 comparisons) keys)
    (parachute:true paired)
    (parachute:is equal nil pending)
    (parachute:is equal (loop for n downfrom 257 above 0 collect n) input)))


(defun f1-list (source)
  (let ((view source) (out nil))
    (loop for step below 10000
          until (sophie-lisp:seq-emptyp view)
          do (push (sophie-lisp:seq-first view) out)
             (setf view (sophie-lisp:seq-rest view))
          finally (unless (sophie-lisp:seq-emptyp view)
                    (parachute:true nil "F1-LIST exceeded its finite fixture bound")))
    (nreverse out)))

(defun f1-lazy (items visit)
  (sophie-lisp:make-lazy-seq
   (lambda ()
     (funcall visit items)
     (if items (sophie-lisp:lazy-cons (car items) (f1-lazy (cdr items) visit)) nil))))

(defclass f1-source () ((items :initarg :items :reader f1-items)))
(defclass f1-collected (f1-source) ())
(defclass f1-collector ()
  ((items :initform nil :accessor f1-buffer)
   (result :initform nil :accessor f1-result)))
(defvar *f1-refuse* nil)
(defmethod sophie-lisp:seqablep ((x f1-source)) t)
(defmethod sophie-lisp:seq-emptyp ((x f1-source)) (null (f1-items x)))
(defmethod sophie-lisp:seq-first ((x f1-source)) (car (f1-items x)))
(defmethod sophie-lisp:seq-rest ((x f1-source)) (cdr (f1-items x)))
(defmethod sophie-lisp:make-collector-for ((x f1-collected) &key)
  (make-instance 'f1-collector))
(defmethod sophie-lisp:collector-accumulate ((c f1-collector) item)
  (when *f1-refuse* (error *f1-refuse*))
  (push item (f1-buffer c)) c)
(defmethod sophie-lisp:collector-result ((c f1-collector))
  (or (f1-result c)
      (setf (f1-result c) (make-instance 'f1-collected :items (reverse (f1-buffer c))))))

(defun f1-vector-check (function items expected)
  (let* ((source (make-array 6 :element-type '(unsigned-byte 8)
                             :initial-contents (append items '(99 98 97)) :fill-pointer 3))
         (result (funcall function source)))
    (parachute:is equalp (coerce expected 'vector) result)
    (parachute:is equal (array-element-type source) (array-element-type result))
    (parachute:false (eq source result))
    (parachute:is equal items (coerce source 'list))
    (parachute:is = 99 (aref source 3)))
  (let* ((source (make-array 0 :element-type 'bit)) (result (funcall function source)))
    (parachute:is = 0 (length result))
    (parachute:is equal (array-element-type source) (array-element-type result))
    (parachute:false (eq source result))))

(defun f1-timing (function expected)
  (let ((visits 0))
    (let ((result (funcall function (f1-lazy '(3 1 2) (lambda (x) (declare (ignore x)) (incf visits))))))
      ;; Return representation does not imply deferred input traversal.
      (parachute:is = 4 visits)
      (parachute:true (sophie-lisp:lazy-seq-p result))
      (parachute:is equal expected (f1-list result))
      (parachute:is = 4 visits)))
  (let* ((sentinel (make-condition 'simple-error :format-control "finite end sentinel"))
         (calls 0)
         (source (f1-lazy '(3 1 2) (lambda (tail) (incf calls) (unless tail (error sentinel))))))
    (parachute:is eq sentinel (handler-case (progn (funcall function source) nil) (error (c) c)))
    (parachute:is = 4 calls)))

(defun f1-extension (function expected)
  (let ((result (funcall function (make-instance 'f1-collected :items '(3 1 2)))))
    (parachute:true (typep result 'f1-collected))
    (parachute:is equal expected (f1-items result)))
  (let ((result (funcall function (make-instance 'f1-source :items '(3 1 2)))))
    (parachute:true (sophie-lisp:lazy-seq-p result))
    (parachute:is equal expected (f1-list result)))
  (let ((*f1-refuse* (make-condition 'simple-error :format-control "collector refusal")))
    (parachute:is eq *f1-refuse*
                  (handler-case (progn (funcall function (make-instance 'f1-collected :items '(3 1 2))) nil)
                    (error (c) c)))))

(parachute:define-test seq-reverse.representations-and-validation
  (f1-vector-check #'sophie-lisp:seq-reverse '(1 2 3) '(3 2 1))
  (parachute:is equal '(3 2 1) (sophie-lisp:seq-reverse '(1 2 3)))
  (parachute:is string= "cba" (sophie-lisp:seq-reverse "abc"))
  (let* ((source (sophie-lisp:ordered-dict :a 7 :b 8))
         (normalized (f1-list source))
         (result (sophie-lisp:seq-reverse source)))
    (parachute:true (sophie-lisp:ordered-dict-p result))
    (parachute:true (every (lambda (entry) (typep entry 'sophie-lisp:map-entry))
                           (f1-list result)))
    (parachute:is equal
                  (mapcar (lambda (entry) (list (sophie-lisp:entry-key entry)
                                                 (sophie-lisp:entry-value entry)))
                          (reverse normalized))
                  (mapcar (lambda (entry) (list (sophie-lisp:entry-key entry)
                                                 (sophie-lisp:entry-value entry)))
                          (f1-list result))))
  (dolist (key '(:test :test-not :key :start))
    (parachute:fail (funcall #'sophie-lisp:seq-reverse '(1) key nil) program-error)))

(parachute:define-test seq-reverse.forcing
  (f1-timing #'sophie-lisp:seq-reverse '(2 1 3)))

(parachute:define-test seq-reverse.extensions
  (f1-extension #'sophie-lisp:seq-reverse '(2 1 3))
  (let ((table (make-hash-table)))
    (setf (gethash :a table) 7 (gethash :b table) 8)
    (dolist (source (list table (sophie-lisp:dict :a 7 :b 8)))
      (let ((result (sophie-lisp:seq-reverse source)))
        (parachute:true (sophie-lisp:ordered-dict-p result))
        (parachute:is = 2 (sophie-lisp:dict-size result))
        (parachute:is = 7 (sophie-lisp:dict-ref result :a))
        (parachute:is = 8 (sophie-lisp:dict-ref result :b)))))
  (let ((result (sophie-lisp:seq-reverse (sophie-lisp:hash-set 1 2 3))))
    (parachute:true (sophie-lisp:lazy-seq-p result))
    (parachute:is equal '(1 2 3) (sort (f1-list result) #'<))))

(parachute:define-test seq-sort.ordering-and-validation
  (f1-vector-check #'sophie-lisp:seq-sort '(3 1 2) '(1 2 3))
  (parachute:is equal '(1 2 3) (sophie-lisp:seq-sort '(3 1 2) :key nil))
  (parachute:is equal '(3 2 1) (sophie-lisp:seq-sort '(3 1 2) :test #'> :key #'identity))
  (dolist (key '(:test-not :start :end :from-end :count :unknown))
    (parachute:fail (sophie-lisp:seq-sort '(1) key nil) program-error)))

(parachute:define-test seq-sort.forcing-and-callbacks
  (f1-timing #'sophie-lisp:seq-sort '(1 2 3))
  (let ((keys nil) (comparisons 0))
    (parachute:is equal '(1 2 3)
      (sophie-lisp:seq-sort '(3 1 2) :key (lambda (x) (push x keys) x)
                               :test (lambda (a b) (incf comparisons) (< a b))))
    (parachute:true (plusp comparisons))
    ;; No prescribed sorting algorithm or exact number of repeated key calls.
    (parachute:is equal '(1 2 3) (sort (remove-duplicates keys) #'<)))
  (dolist (option '(:key :test))
    (let* ((calls 0)
           (source (f1-lazy '(3 1 2) (lambda (x) (declare (ignore x)) (incf calls)))))
      (parachute:fail (sophie-lisp:seq-sort source option 42) type-error)
      (parachute:is = 0 calls)))
  (dolist (option '(:key :test))
    (let ((sentinel (make-condition 'simple-error :format-control "sort callback")))
      (parachute:is eq sentinel
        (handler-case
            (sophie-lisp:seq-sort '(3 1 2) option
              (lambda (&rest values) (declare (ignore values)) (error sentinel)))
          (error (c) c)))))
  (f1-uncached-keys #'sophie-lisp:seq-sort))

(defun f1-coalescing-sort-check (operation)
  (let* ((first (copy-seq "a")) (second (copy-seq "a"))
         (table (make-hash-table :test 'eql)) (compared nil))
    (setf (gethash first table) 2 (gethash second table) 1 (gethash "b" table) 3)
    (let ((result (funcall operation table :key #'sophie-lisp:entry-value
                           :test (lambda (left right)
                                   (push (list left right) compared) (< left right)))))
      (parachute:true (sophie-lisp:ordered-dict-p result))
      (parachute:is = 2 (sophie-lisp:dict-size result))
      (parachute:is = 1 (count-if (lambda (entry)
                                    (string= "a" (sophie-lisp:entry-key entry)))
                                  (f1-list result)))
      (parachute:true (apply #'<= (mapcar #'sophie-lisp:entry-value (f1-list result))))
      (parachute:true (plusp (length compared)))
      (parachute:is = 1
                    (length (remove-duplicates
                             (remove-if-not (lambda (value) (member value '(1 2)))
                                            (apply #'append compared))))))))

(parachute:define-test seq-sort.extensions-and-coalescing
  (f1-extension #'sophie-lisp:seq-sort '(1 2 3))
  (dolist (pair (list (list 1 :a) (list #c(1 2) 2) (list nil :a)))
    (parachute:fail (sophie-lisp:seq-sort pair) simple-error))
  (parachute:is equal '((1 b) (2 a)) (sophie-lisp:seq-sort '((2 a) (1 b)) :key #'car))
  (let ((result (sophie-lisp:seq-sort (sophie-lisp:hash-set 3 1 2))))
    (parachute:true (sophie-lisp:lazy-seq-p result))
    (parachute:is equal '(1 2 3) (f1-list result)))
  (let ((table (make-hash-table)))
    (setf (gethash :b table) 2 (gethash :a table) 1)
    (dolist (source (list table (sophie-lisp:dict :b 2 :a 1)))
      (let ((result (sophie-lisp:seq-sort source :key #'sophie-lisp:entry-value)))
        (parachute:true (sophie-lisp:ordered-dict-p result))
        (parachute:is equal '(1 2)
                      (mapcar #'sophie-lisp:entry-value (f1-list result))))))
  (f1-coalescing-sort-check #'sophie-lisp:seq-sort))

(parachute:define-test seq-stable-sort.ordering-and-validation
