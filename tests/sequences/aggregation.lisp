(parachute:define-test seq-trim-right.forcing-and-predicates
  (f2-timing (lambda (s) (sophie-lisp:seq-trim-right s :predicate #'zerop)) '(0 1 0 2))
  (let* ((visits 0) (source (f2-lazy '(1) (lambda (x) (declare (ignore x)) (incf visits)))))
    (parachute:fail (sophie-lisp:seq-trim-right source) program-error)
    (parachute:is = 0 visits))
  (parachute:is equal '(0 1 0 2)
    (sophie-lisp:seq-trim-right '(0 1 0 2 0) :predicate #'zerop))
  (f2-predicate-events #'sophie-lisp:seq-trim-right '(0 0 1 0 2)))

(parachute:define-test seq-trim-right.extensions
  (f2-roster (lambda (s) (sophie-lisp:seq-trim-right s :predicate (constantly nil))))
  (let ((calls 0))
    (let ((result (sophie-lisp:seq-trim-right (sophie-lisp:dict :a 1)
                    :predicate (lambda (e) (incf calls) (typep e 'sophie-lisp:map-entry)))))
      (parachute:is = 1 calls)
      (parachute:is = 0 (sophie-lisp:seq-length result))))
  (let ((*f2-refuse* (make-condition 'simple-error :format-control "refuse reconstruction")))
    (parachute:is eq *f2-refuse*
      (handler-case (sophie-lisp:seq-trim-right (make-instance 'f2-source :items '(1))
                                              :predicate #'zerop)
        (error (c) c)))))

(parachute:define-test seq-trim.representations-and-validation
  (parachute:is string= "x" (sl:seq-trim " x "))
  (f2-vector (lambda (s) (sophie-lisp:seq-trim s :predicate #'zerop)) '(1 0 2))
  (let* ((source (copy-seq "  x  "))
         (result (sophie-lisp:seq-trim source :predicate (lambda (c) (char= c #\Space)))))
    (parachute:is string= "x" result)
    (parachute:false (eq source result))
    (parachute:is string= "  x  " source))
  (dolist (key '(:test :test-not :key))
    (parachute:fail (sophie-lisp:seq-trim "x" key nil) program-error))
  (parachute:fail (sophie-lisp:seq-trim "x" :predicate nil) program-error))
(parachute:define-test seq-trim.forcing-and-predicates
  (f2-timing (lambda (s) (sophie-lisp:seq-trim s :predicate #'zerop)) '(1 0 2))
  (parachute:is equal '(1 0 2) (sophie-lisp:seq-trim '(0 1 0 2 0) :predicate #'zerop))
  (parachute:is equal nil (sophie-lisp:seq-trim '(0 0 0) :predicate #'zerop))
  (f2-predicate-events #'sophie-lisp:seq-trim '(1 0 2)))
(parachute:define-test seq-trim.extensions
  (f2-roster (lambda (s) (sophie-lisp:seq-trim s :predicate (constantly nil))))
  (let ((calls 0))
    (let ((result (sophie-lisp:seq-trim (sophie-lisp:hash-set 1 2 3)
                     :predicate (lambda (x) (declare (ignore x)) (incf calls) t))))
      (parachute:is = 3 calls)
      (parachute:true (sophie-lisp:lazy-seq-p result))
      (parachute:true (sophie-lisp:seq-emptyp result))
      (parachute:is = 3 calls)))
  (let* ((visits 0) (source (f2-lazy '(1) (lambda (x) (declare (ignore x)) (incf visits)))))
    (parachute:fail (sophie-lisp:seq-trim source) program-error)
    (parachute:is = 0 visits))
  (let ((*f2-refuse* (make-condition 'simple-error :format-control "refuse trim")))
    (parachute:is eq *f2-refuse*
      (handler-case (sophie-lisp:seq-trim (make-instance 'f2-source :items '(1)) :predicate #'zerop)
        (error (c) c)))))

;;;; Independent reduction oracle: construct association trees, not CL:REDUCE.
(defun l01-r-lazy (items observe)
  (sl:make-lazy-seq (lambda () (funcall observe (if items (car items) :end))
                     (if items (sl:lazy-cons (car items) (l01-r-lazy (cdr items) observe)) nil))))
(defun l01-r-error (thunk type)
  ;; ECL's TYPEP returns a truthy class-precedence list, not T, when the
  ;; signaled condition's class is a strict subclass of TYPE; normalize to a
  ;; strict boolean so the EQ-T assertions hold on every host.
  (handler-case (progn (funcall thunk) nil)
    (error (c) (if (typep c type) t nil))))
(defclass l01-r-source () ((items :initarg :items :reader l01-r-items)))
(defmethod sl:seqablep ((s l01-r-source)) t)
(defmethod sl:seq-emptyp ((s l01-r-source)) (null (l01-r-items s)))
(defmethod sl:seq-first ((s l01-r-source)) (car (l01-r-items s)))
(defmethod sl:seq-rest ((s l01-r-source)) (make-instance 'l01-r-source :items (cdr (l01-r-items s))))
(defmethod sl:make-collector-for ((s l01-r-source) &key) (error "Scalar reduction Collector"))
(defun l01-r-model (items backwards seeded seed)
  (let* ((xs (mapcar #'1+ (if backwards (reverse items) items)))
         (acc (if seeded seed (pop xs))))
    (dolist (x xs acc) (setf acc (if backwards (list x acc) (list acc x))))))

(parachute:define-test seq-reduce.finite-model-and-validation
  (parachute:is eq t (typep (fdefinition 'sl:seq-reduce) 'generic-function))
  (loop for seed from 1 to 20
        for items = (loop for i below (+ 1 (mod seed 7)) collect (mod (+ seed (* i 13)) 17))
        do (dolist (backwards '(nil t))
             (dolist (seeded '(nil t))
               (dolist (source (list items (coerce items 'vector)))
                 (parachute:is equal (l01-r-model items backwards seeded nil)
                   (apply #'sl:seq-reduce #'list source :key #'1+ :from-end backwards
                          (when seeded (list :initial-value nil))))))))
  (parachute:is = 9 (sl:seq-reduce #'+ #(1 2 3) :key #'1+ :initial-value 0))
  (parachute:is equal '(nil 3) (sl:seq-reduce #'list '(3) :initial-value nil))
  (parachute:is equal '(3 nil) (sl:seq-reduce #'list '(3) :initial-value nil :from-end t))
  (parachute:is = 5 (sl:seq-reduce #'+ #(9 2 3 8) :start 1 :end 3 :key nil))
  (parachute:is = 6 (sl:seq-reduce #'+ #(1 2 3) :end 99))
  (parachute:is = 3 (sl:seq-reduce #'+ (make-array 4 :initial-contents '(1 2 99 99) :fill-pointer 2)))
  (dolist (keyword '(:test :test-not))
    (parachute:is eq t (l01-r-error (lambda () (funcall 'sl:seq-reduce #'+ '(1) keyword nil)) 'program-error))))

(parachute:define-test seq-reduce.forcing-and-order
  (dolist (backwards '(nil t))
    (let ((forces nil) (keys nil) (calls nil))
      (parachute:is equal (if backwards '(2 (3 :seed)) '((:seed 2) 3))
        (sl:seq-reduce (lambda (a b) (push (list a b) calls) (values (list a b) :ignored))
                       (l01-r-lazy '(9 2 3 8) (lambda (x) (push x forces) (when (eql x 8) (error "past END"))))
                       :start 1 :end 3 :from-end backwards :initial-value :seed
                       :key (lambda (x) (push x keys) (values x :ignored))))
      (parachute:is equal '(9 2 3) (reverse forces))
      (parachute:is equal (if backwards '(3 2) '(2 3)) (reverse keys))
      (parachute:is equal (if backwards '((3 :seed) (2 (3 :seed))) '((:seed 2) ((:seed 2) 3)))
        (reverse calls))))
  (let ((sentinel (make-condition 'simple-error :format-control "zero-end sentinel")))
    (parachute:is eq :seed
      (sl:seq-reduce #'+
                     (l01-r-lazy '(1) (lambda (x) (declare (ignore x)) (error sentinel)))
                     :end 0 :initial-value :seed)))
  (let ((events nil))
    (parachute:is = 6 (sl:seq-reduce #'+ (l01-r-lazy '(1 2 3) (lambda (x) (push x events)))))
    (parachute:is equal '(1 2 3 :end) (reverse events)))
  (let ((marker (make-condition 'simple-error :format-control "end sentinel")))
    (parachute:is eq marker
      (handler-case (sl:seq-reduce #'+ (l01-r-lazy '(1 2) (lambda (x) (when (eq x :end) (error marker)))))
        (error (c) c))))
  (let ((calls 0) (keys 0))
    (parachute:is = 4 (sl:seq-reduce (lambda (&rest xs) (declare (ignore xs)) (incf calls)) '(3)
                                    :key (lambda (x) (incf keys) (1+ x))))
    (parachute:is equal '(0 1) (list calls keys))))

(parachute:define-test seq-reduce.empty-input-and-errors
  (let ((calls 0) (keys 0) (seed (list :seed)))
    (dolist (source (list nil #() (sl:make-lazy-seq (lambda () nil))))
      ;; Sophie does NOT invoke FUNCTION with zero arguments on empty input.
      (parachute:is eq t
        (l01-r-error (lambda () (sl:seq-reduce (lambda (&rest xs) (declare (ignore xs)) (incf calls)) source)) 'simple-error))
      (parachute:is eq seed
        (sl:seq-reduce (lambda (&rest xs) (declare (ignore xs)) (incf calls)) source
                       :initial-value seed :key (lambda (x) (incf keys) x))))
    (parachute:is = 0 calls)
    (parachute:is = 0 keys))
  (parachute:is eq nil (sl:seq-reduce #'+ '(1 2) :start 2 :initial-value nil))
  (parachute:is eq t (l01-r-error (lambda () (sl:seq-reduce #'+ '(1 2) :start 2)) 'simple-error))
  (parachute:is equal '(1 (2 3)) (sl:seq-reduce #'list '(1 2 3) :from-end t))
  (parachute:is = 6 (sl:seq-reduce '+ (make-instance 'l01-r-source :items '(1 2 3))))
  (dolist (options '((:start -1) (:start 1/2) (:end 1/2) (:start 2 :end 1) (:key 42)))
    (let ((forces 0))
      (parachute:is eq t
        (l01-r-error (lambda () (apply #'sl:seq-reduce #'+
                                  (l01-r-lazy '(1) (lambda (x) (declare (ignore x)) (incf forces))) options)) 'type-error))
      (parachute:is = 0 forces)))
  (dolist (function (list nil 42 'l01-r-unbound-function))
    (let ((forces 0))
      (parachute:is eq t
        (l01-r-error (lambda () (sl:seq-reduce function
                                (l01-r-lazy '(1) (lambda (x) (declare (ignore x)) (incf forces))))) 'type-error))
      (parachute:is = 0 forces)))
  (parachute:is eq t (l01-r-error (lambda () (sl:seq-reduce #'+ '(1) :start 2)) 'type-error))
  (parachute:is eq t (l01-r-error (lambda () (sl:seq-reduce #'+ 42)) 'type-error))
  (let ((marker (make-condition 'simple-error :format-control "callback sentinel")))
    (parachute:is eq marker
      (handler-case (sl:seq-reduce (lambda (a b) (declare (ignore a b)) (error marker)) '(1 2))
        (error (c) c)))
    (parachute:is eq marker
      (handler-case (sl:seq-reduce #'+ '(1) :key (lambda (x) (declare (ignore x)) (error marker)))
        (error (c) c)))))

(parachute:define-test eager-traversal.aggregation-equivalence
  (dolist (operation
           (list (lambda (source) (sl:seq-reverse source))
                 (lambda (source) (sl:seq-sort source :test (lambda (a b)
                                                            (declare (ignore a b)) nil)))
                 (lambda (source) (sl:seq-stable-sort source :test (lambda (a b)
                                                                   (declare (ignore a b)) nil)))
                 (lambda (source) (sl:seq-take-last 2 source))
                 (lambda (source)
                   (sl:seq-trim-right source :predicate
                                      (lambda (item)
                                        (eager-traversal-query-record :trim item)
                                        nil)))
                 (lambda (source)
                   (sl:seq-trim source :predicate
                                (lambda (item)
                                  (eager-traversal-query-record :trim item)
                                  nil)))))
    (eager-traversal-check-corpus operation :expected-dotted-callbacks nil))
  (dolist (bounds '((0 nil) (0 0) (0 2) (1 3) (2 2) (4 4) (5 nil)))
    (dolist (backwards '(nil t))
      (dolist (seeded '(nil t))
        (eager-traversal-check-corpus
         (lambda (source)
           (apply #'sl:seq-reduce
                  (lambda (left right)
                    (eager-traversal-query-record :combine left right)
                    (list left right))
                  source :start (first bounds) :end (second bounds)
                  :from-end backwards
                  :key (lambda (item)
                         (eager-traversal-query-record :key item)
                         1)
                  (when seeded (list :initial-value :seed))))
         :expected-dotted-callbacks nil)))
  (dolist (generic-p '(nil t))
    (let ((sophie-lisp.internal::*force-generic-traversal* generic-p)
          (source (list 3 1 2)))
      (let ((result (sl:seq-reverse source)))
        (parachute:is equal '(2 1 3) result)
        (parachute:is eq nil (eq source result)))
      (let ((result (sl:seq-sort source)))
        (parachute:is equal '(1 2 3) result)
        (parachute:is eq nil (eq source result)))))))
