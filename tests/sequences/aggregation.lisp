(parachute:define-test seq-stable-sort.extensions-and-stability
  (f1-extension #'sophie-lisp:seq-stable-sort '(1 2 3))
  (let* ((a (list 1 :a)) (b (list 1.0 :b)) (c (list 0 :c))
         (source (vector a b c))
         (result (sophie-lisp:seq-stable-sort source :key #'car)))
    (parachute:is eq c (aref result 0))
    (parachute:is eq a (aref result 1))
    (parachute:is eq b (aref result 2))
    (parachute:is eq t (array-element-type result)))
  (f1-coalescing-sort-check #'sophie-lisp:seq-stable-sort))

;;; Frozen pre-optimization merge schedule: a test oracle, not a production helper.
(defun f1-sort-schedule-oracle (elements test key)
  (let* ((input (coerce elements 'vector))
         (size (length input))
         (output (make-array size)))
    (loop for width = 1 then (* 2 width)
          while (< width size)
          do (loop for start from 0 below size by (* 2 width)
                   for middle = (min size (+ start width))
                   for end = (min size (+ middle width))
                   do (let ((left start) (right middle))
                        (loop for destination from start below end
                              do (setf (aref output destination)
                                       (cond
                                         ((= left middle)
                                          (prog1 (aref input right) (incf right)))
                                         ((= right end)
                                          (prog1 (aref input left) (incf left)))
                                         ((funcall test (funcall key (aref input right))
                                                   (funcall key (aref input left)))
                                          (prog1 (aref input right) (incf right)))
                                         (t
                                          (prog1 (aref input left) (incf left))))))))
          (rotatef input output))
    (coerce input 'list)))

(parachute:define-test seq-sort.pre-optimization-callback-traces
  (dolist (operation '(sophie-lisp:seq-sort sophie-lisp:seq-stable-sort))
    (dolist (items '(() ((2 a)) ((3 a) (1 b) (3 c) (2 d) (1 e))
                     ((0 a) (0 b) (0 c) (0 d))
                     ((7 a) (1 b) (5 c) (4 d) (0 e) (7 f) (1 g) (4 h) (3 i))))
      (let ((expected-events nil) (actual-events nil)
            (source (coerce items 'vector)))
        (flet ((expected-key (item)
                 (push (list :key (second item)) expected-events)
                 (first item))
               (expected-test (right left)
                 (push (list :test right left) expected-events)
                 (< right left))
               (actual-key (item)
                 (push (list :key (second item)) actual-events)
                 (first item))
               (actual-test (right left)
                 (push (list :test right left) actual-events)
                 (< right left)))
          (let ((expected (f1-sort-schedule-oracle items #'expected-test #'expected-key))
                (actual (funcall operation source :key #'actual-key :test #'actual-test)))
            (parachute:is equal expected (coerce actual 'list))
            (parachute:is equal (nreverse expected-events) (nreverse actual-events))
            (parachute:is equal items (coerce source 'list))))))))

(defun f2-predicate-events (function expected)
  (let ((events nil))
    (let ((result (funcall function '(0 0 1 0 2 0 0)
                   :predicate (lambda (x) (push x events) (zerop x)))))
      (parachute:is equal expected result)
      (parachute:is equal '(0 0 1 0 2 0 0) (reverse events))))
  (let ((events nil)
        (sentinel (make-condition 'simple-error :format-control "trim predicate escape")))
    (parachute:is eq sentinel
      (handler-case
          (funcall function '(0 0 1 0 2 0 0)
            :predicate (lambda (x)
                         (push x events)
                         (when (= x 2) (error sentinel))
                         (zerop x)))
        (error (c) c)))
    ;; No trailing predicate calls after the escaped invocation.
    (parachute:is equal '(0 0 1 0 2) (reverse events))))



(defun f2-list (source)
  (let ((view source) (out nil))
    (loop for step below 10000
          until (sophie-lisp:seq-emptyp view)
          do (push (sophie-lisp:seq-first view) out)
             (setf view (sophie-lisp:seq-rest view))
          finally (unless (sophie-lisp:seq-emptyp view)
                    (parachute:true nil "F2-LIST exceeded its finite fixture bound")))
    (nreverse out)))
(defun f2-lazy (items visit)
  (sophie-lisp:make-lazy-seq
   (lambda () (funcall visit items)
     (if items (sophie-lisp:lazy-cons (car items) (f2-lazy (cdr items) visit)) nil))))
(defclass f2-source () ((items :initarg :items :reader f2-items)))
(defclass f2-collector ()
  ((items :initform nil :accessor f2-buffer)
   (result :initform nil :accessor f2-result)))
(defvar *f2-refuse* nil)
(defmethod sophie-lisp:seqablep ((x f2-source)) t)
(defmethod sophie-lisp:seq-emptyp ((x f2-source)) (null (f2-items x)))
(defmethod sophie-lisp:seq-first ((x f2-source)) (car (f2-items x)))
(defmethod sophie-lisp:seq-rest ((x f2-source)) (cdr (f2-items x)))
(defmethod sophie-lisp:make-collector-for ((x f2-source) &key)
  (make-instance 'f2-collector))
(defmethod sophie-lisp:collector-accumulate ((c f2-collector) x)
  (when *f2-refuse* (error *f2-refuse*)) (push x (f2-buffer c)) c)
(defmethod sophie-lisp:collector-result ((c f2-collector))
  (or (f2-result c)
      (setf (f2-result c) (make-instance 'f2-source :items (reverse (f2-buffer c))))))

(defun f2-timing (function expected)
  (let ((visits 0))
    (let ((result (funcall function
                   (f2-lazy '(0 1 0 2 0) (lambda (x) (declare (ignore x)) (incf visits))))))
      (parachute:is = 6 visits)
      (parachute:true (sophie-lisp:lazy-seq-p result))
      (parachute:is equal expected (f2-list result))
      (parachute:is = 6 visits)))
  (let* ((sentinel (make-condition 'simple-error :format-control "finite trailing sentinel"))
         (source (f2-lazy '(0 1 0 2 0) (lambda (tail) (unless tail (error sentinel))))))
    (parachute:is eq sentinel
      (handler-case (progn (funcall function source) nil) (error (c) c)))))

(defun f2-vector (function expected)
  (let* ((source (make-array 7 :element-type '(unsigned-byte 8) :fill-pointer 5
                             :initial-contents '(0 1 0 2 0 99 98)))
         (result (funcall function source)))
    (parachute:is equal expected (coerce result 'list))
    (parachute:is equal (array-element-type source) (array-element-type result))
    (parachute:false (eq source result))
    (parachute:is equal '(0 1 0 2 0) (coerce source 'list)))
  (let* ((source (make-array 0 :element-type 'bit)) (result (funcall function source)))
    (parachute:is = 0 (length result))
    (parachute:is equal (array-element-type source) (array-element-type result))
    (parachute:false (eq source result))))

(defun f2-roster (function)
  ;; Retain all entries: independent traversals need not choose the same order.
  (let ((table (make-hash-table :test 'eq)) (value (list :value)))
    (setf (gethash :a table) value)
    (dolist (source (list table (sophie-lisp:dict :a value)))
      (let ((result (funcall function source)))
        (parachute:true (typep result (class-of source)))
        (parachute:is eq (sophie-lisp:dict-test source) (sophie-lisp:dict-test result))
        (parachute:is = 1 (sophie-lisp:seq-length result))
        (parachute:is eq value (sophie-lisp:entry-value (sophie-lisp:seq-first result)))))
    (parachute:false (eq table (funcall function table)))))

(parachute:define-test seq-take-last.representations-and-validation
  (f2-vector (lambda (s) (sophie-lisp:seq-take-last 2 s)) '(2 0))
  (parachute:is equal '(3 4) (sophie-lisp:seq-take-last 2 '(1 2 3 4)))
  (parachute:is equal '(1 2) (sophie-lisp:seq-take-last 10 '(1 2)))
  (dolist (n '(-1 1/2 nil))
    (parachute:fail (sophie-lisp:seq-take-last n '(1)) type-error))
  (dolist (key '(:test :key))
    (parachute:fail (funcall #'sophie-lisp:seq-take-last 1 '(1) key nil) program-error)))

(parachute:define-test seq-take-last.forcing-and-empty-results
  (f2-timing (lambda (s) (sophie-lisp:seq-take-last 2 s)) '(2 0))
  (let ((visits 0))
    (let ((result
            (sophie-lisp:seq-take-last 0
              (f2-lazy '(1) (lambda (tail) (declare (ignore tail)) (incf visits))))))
      (parachute:is = 0 visits)
      (parachute:true (sophie-lisp:seq-emptyp result))
      (parachute:is = 0 visits)))
  (let* ((source (vector 1 2)) (result (sophie-lisp:seq-take-last 0 source)))
    (parachute:is = 0 (length result))
    (parachute:false (eq source result)))
  (let* ((source (copy-seq "abc")) (result (sophie-lisp:seq-take-last 0 source)))
    (parachute:is string= "" result)
    (parachute:false (eq source result)))
  (parachute:true (sophie-lisp:seq-emptyp (sophie-lisp:seq-take-last 0 nil))))

(parachute:define-test seq-take-last.extensions
  (f2-roster (lambda (s) (sophie-lisp:seq-take-last 10 s)))
  (let* ((source (sophie-lisp:dict :a 1 :b 2 :c 3))
