                          (sort (mapcar (lambda (e) (list (sl:entry-key e) (sl:entry-value e))) left)
                                #'< :key #'first))
            (parachute:is equal '(1 2 3) (sort left #'<))))))
)

;;;; Independent Chapter 6 substitution oracles. No pending operation is used
;;;; as a helper: observation and extension fixtures belong to S-POLICY.
(defun select0-stream (items counter)
  (sl:make-lazy-seq
   (lambda ()
     (incf (car counter))
     (if items
         (sl:lazy-cons (car items) (select0-stream (cdr items) counter))
         nil))))

(defun select0-model-check (operation oracle)
  ;; 2 directions * 4 counts * 3 starts * 3 ends = 72 finite models.
  (dolist (back '(nil t))
    (dolist (count '(nil 0 1 2))
      (dolist (start '(0 1 3))
        (dolist (end '(3 5 9))
          (let* ((source (list 1 2 1 3 1))
                 (options (list :start start :end end :count count :from-end back))
                 (expected (apply oracle source :start start :end (min end 5)
                                  :count count :from-end back nil))
                 (result (apply operation source options)))
            (parachute:is equal expected result)
            (parachute:false (eq source result))
            (parachute:is equal '(1 2 1 3 1) source)))))))

(defun select0-representation (operation dictionary-operation)
  ;; Each operation replaces selected A characters with a non-character.
  (let* ((source (copy-seq "aba")) (result (funcall operation source)))
    (parachute:is equalp #(9 #\b 9) result)
    (parachute:is eq t (array-element-type result))
    (parachute:false (eq source result))
    (parachute:is string= "aba" source))
  (let ((result (funcall operation "bbb")))
    (parachute:true (stringp result))
    (parachute:is string= "bbb" result))
  (let ((calls 0))
    (dolist (source (list (sl:dict :a 1 :b 2)
                          (let ((h (make-hash-table)))
                            (setf (gethash :a h) 1 (gethash :b h) 2) h)))
      (let ((result (funcall dictionary-operation source
                             (lambda (x) (declare (ignore x)) (incf calls) 1))))
        (parachute:true (sl:ordered-dict-p result))
        (parachute:is = 2 calls)
        (parachute:true (every (lambda (entry) (typep entry 'sl:map-entry))
                               (policy-list result)))
        (parachute:is = 1 (length (policy-list result)))
        (parachute:is eq :replacement (sl:entry-key (first (policy-list result))))
        (parachute:is = 9 (sl:entry-value (first (policy-list result))))
        (parachute:is equal '((:replacement 9))
                      (mapcar (lambda (entry) (list (sl:entry-key entry) (sl:entry-value entry)))
                              (policy-list result)))
        (parachute:is = 2 calls)
        (setf calls 0))))
  (let ((calls 0))
    (let ((result (funcall dictionary-operation (sl:hash-set 1 2)
                           (lambda (x) (declare (ignore x)) (incf calls) 1))))
      (parachute:true (sl:lazy-seq-p result))
      (parachute:is = 0 calls)
      (parachute:is equal '((:replacement 9) (:replacement 9))
                    (mapcar (lambda (entry) (list (sl:entry-key entry) (sl:entry-value entry)))
                            (policy-list result)))
      (parachute:is = 2 calls)
      (parachute:is equal '((:replacement 9) (:replacement 9))
                    (mapcar (lambda (entry) (list (sl:entry-key entry) (sl:entry-value entry)))
                            (policy-list result)))
      (parachute:is = 2 calls))))

(parachute:define-test seq-substitute.model-and-representations
  (select0-model-check (lambda (s &rest o) (apply #'sl:seq-substitute 9 1 s o))
                      (lambda (s &rest o) (apply #'substitute 9 1 s o)))
  (let* ((s (make-array 4 :element-type '(unsigned-byte 8)
                        :initial-contents '(1 2 3 99) :fill-pointer 3))
         (r (sl:seq-substitute 9 2 s :test #'eql :key nil :count 1)))
    (parachute:is equalp #(1 9 3) r)
    (parachute:is eq t (array-element-type r))
    (parachute:false (eq s r)))
  (parachute:is equal '(9 9 2) (sl:seq-substitute 9 1 '(1 1.0 2)))
  (parachute:is equal '(9 1.0 2) (sl:seq-substitute 9 1 '(1 1.0 2) :test #'eql))
  (parachute:fail (sl:seq-substitute 9 1 nil :test-not #'eql) 'program-error))

(parachute:define-test seq-substitute-if.model-and-representations
  (select0-model-check (lambda (s &rest o) (apply #'sl:seq-substitute-if 9 #'oddp s o))
                      (lambda (s &rest o) (apply #'substitute-if 9 #'oddp s o)))
  (let ((r (sl:seq-substitute-if 9 #'oddp #*101 :count 1 :key nil)))
    (parachute:is equalp #(9 0 1) r)
    (parachute:is eq t (array-element-type r)))
  (parachute:fail (sl:seq-substitute-if 9 #'oddp nil :test #'eql) 'program-error)
  (parachute:fail (sl:seq-substitute-if 9 #'oddp nil :test-not #'eql) 'program-error)
  (parachute:is equal '(9 2) (sl:seq-substitute-if 9 #'oddp '(1 2) :key nil)))

(defun select0-timing (operation)
  (let* ((forces (list 0)) (keys nil)
         (s (select0-stream '(1 2 1 3) forces))
         (r (funcall operation s (lambda (x) (push x keys) x))))
    (parachute:is = 0 (car forces))
    (parachute:is equal nil keys)
    (parachute:is = 1 (sl:seq-first r))
    ;; All four selected elements, but not the END sentinel, are required.
    (parachute:is = 4 (car forces))
    (parachute:is equal '(1 1 2 3) (sort (copy-list keys) #'<))
    (parachute:is equal '(1 2 9 3) (policy-list r))
    (parachute:is = 4 (length keys))
    (parachute:is equal '(1 2 9 3) (policy-list r))
    (parachute:is = 4 (length keys)))
  (let* ((tag (gensym))
         (s (sl:make-lazy-seq (lambda () (throw tag :reached)))))
    (parachute:is eq :reached
                  (catch tag (sl:seq-first (funcall operation s #'identity)) :miss))))

(parachute:define-test seq-substitute.forcing-and-retry
  (select0-timing (lambda (s k) (sl:seq-substitute 9 1 s :count 1 :from-end t
                                                 :end 4 :key k)))
  (select0-match-retry (lambda (s k p back) (sl:seq-substitute 9 1 s :test (lambda (a b) (funcall p b) (= a b)) :key k :from-end back :count 2 :end 3))))

(parachute:define-test seq-substitute-if.forcing-and-retry
  (select0-timing (lambda (s k) (sl:seq-substitute-if 9 (lambda (x) (= x 1)) s
                                                    :count 1 :from-end t :end 4 :key k)))
  (select0-match-retry (lambda (s k p back) (sl:seq-substitute-if 9 p s :key k :from-end back :count 2 :end 3))))

(defun select0-errors-and-retry (operation)
  (let* ((n (list 0)) (s (select0-stream '(1) n)))
    (dolist (options '((:start -1) (:start 1/2) (:end -1) (:start 2 :end 1)
                       (:count -1) (:count 1/2) (:key 42)))
      (parachute:fail (apply operation s options) 'type-error))
    (parachute:is = 0 (car n)))
  (let* ((attempts 0) (condition (make-condition 'simple-error))
         (s (sl:lazy-cons 1 nil))
         (r (funcall operation s :key (lambda (x)
                                       (when (= 1 (incf attempts)) (error condition)) x))))
    (parachute:is = 0 attempts)
    (parachute:is eq condition (handler-case (sl:seq-first r) (error (e) e)))
    (parachute:is = 9 (sl:seq-first r))
    (parachute:is = 2 attempts)
    (parachute:is = 9 (sl:seq-first r))
    (parachute:is = 2 attempts))
  (let ((symbol (gensym "LATE-KEY")))
    (unwind-protect
         (progn
           (setf (symbol-function symbol) #'identity)
           (let ((r (funcall operation (sl:lazy-cons 2 nil) :key symbol)))
             (setf (symbol-function symbol) (constantly 1))
             (parachute:is = 9 (sl:seq-first r))))
      (fmakunbound symbol)))
  (let* ((s (copy-seq "aba"))
         (r (funcall operation s :count 0 :key (lambda (x) (declare (ignore x))
                                                        (error "Unexpected key")))))
    (parachute:true (stringp r))
    (parachute:is string= s r)
    (parachute:false (eq s r)))
  (let* ((s (make-instance 'policy-child :items '(1 2 3)))
         (r (funcall operation s)))
    (parachute:true (typep r 'policy-child))
    (parachute:is equal '(9 2 3) (policy-source-items r)))
  (dolist (phase '(:create :accumulate :result))
    (let ((*policy-refusal-phase* phase)
          (*policy-refusal* (make-condition 'policy-refusal)))
      (parachute:is eq *policy-refusal*
                    (handler-case
                        (funcall operation (make-instance 'policy-refusing :items '(1 2 3)))
                      (policy-refusal (e) e)))))
  (let* ((n (list 0))
         (tail (sl:make-lazy-seq (lambda () (error "Untouched substitution tail"))))
         (s (sl:make-lazy-seq (lambda () (incf (car n)) (sl:lazy-cons 1 tail))))
         (r (funcall operation s)))
    (parachute:is = 0 (car n))
    (parachute:is = 9 (sl:seq-first r))
    (parachute:is = 1 (car n)))
  (parachute:fail (funcall operation '(1) :start 2 :end 2) 'type-error)
  (let ((r (funcall operation (sl:lazy-cons 1 nil) :start 2 :end 2)))
    (parachute:is = 1 (sl:seq-first r))
    (parachute:fail (policy-list r) 'type-error)))

(parachute:define-test seq-substitute.extensions-and-validation
  (select0-representation (lambda (s) (sl:seq-substitute 9 #\a s))
                          (lambda (s k) (sl:seq-substitute (sl:map-entry :replacement 9) 1 s :key k)))
  (parachute:fail (sl:seq-substitute 9 1 (sl:dict :a 1) :key #'sl:entry-value) type-error)
  (select0-errors-and-retry (lambda (s &rest o) (apply #'sl:seq-substitute 9 1 s o))))

(parachute:define-test seq-substitute-if.extensions-and-validation
  (select0-representation (lambda (s) (sl:seq-substitute-if 9 (lambda (x) (eql x #\a)) s))
                          (lambda (s k) (sl:seq-substitute-if (sl:map-entry :replacement 9) #'oddp s :key k)))
  (parachute:fail (sl:seq-substitute-if 9 (constantly t) (sl:dict :a 1)) type-error)
  (select0-errors-and-retry (lambda (s &rest o)
                            (apply #'sl:seq-substitute-if 9 (lambda (x) (eql x 1)) s o))))

(defun select0-match-retry (operation)
  (dolist (back '(nil t))
    (let* ((keys nil) (matches nil) (escaped nil) (tag (gensym)) (n (list 0))
           (r (funcall operation (select0-stream '(0 1 2) n)
                       (lambda (x) (push x keys) x)
                       (lambda (x)
                         (push x matches)
                         (when (and (= x 1) (not escaped))
                           (setf escaped t) (throw tag :matcher))
                         (= x 1))
                       back)))
      (parachute:is = 0 (car n))
      (unless back (parachute:is = 0 (sl:seq-first r)))
      (parachute:is eq :matcher (catch tag (policy-list r) :miss))
      (parachute:is equal '(0 9 2) (policy-list r))
      (parachute:is equal '(0 1 2) (sort (copy-list keys) #'<))
      (parachute:is = 2 (count 1 matches))
      (let ((saved (copy-list matches)))
        (parachute:is equal '(0 9 2) (policy-list r))
        (parachute:is equal saved matches)))))
