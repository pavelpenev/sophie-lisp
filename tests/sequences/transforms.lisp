    (parachute:is equal '(0) events))
  (let* ((*multi03-collects* 0)
         (r (sl:seq-interleave (make-instance 'multi03-collected :items '(1 2))
                              (make-instance 'multi03-collected :items '(3 4)))))
    (parachute:true (typep r 'multi03-collected))
    (parachute:is equal '(1 3 2 4) (multi03-items r))
    (parachute:is = 1 *multi03-collects*))

  (dolist (class '(multi03-source multi03-collected))
    (let* ((*multi03-collects* 0)
           (r (sl:seq-interleave (make-instance class :items '(1 2))
                                (make-instance class :items '(10 20)))))
      (parachute:true (if (eq class 'multi03-collected)
                          (typep r 'multi03-collected) (sl:lazy-seq-p r)))
      (parachute:is equal '(1 10 2 20) (multi03-list r))))
  (let ((table (make-hash-table)))
    (setf (gethash 1 table) 10 (gethash 2 table) 20 (gethash 3 table) 30)
    (dolist (source (list table (sl:dict 1 10 2 20 3 30) (sl:hash-set 1 2 3)))
      (let* ((items (multi03-list (sl:seq-interleave source '(:a :b :c))))
             (left (loop for (x marker) on items by #'cddr collect x))
