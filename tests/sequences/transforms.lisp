    (parachute:is equal '(1 1) (multi03-list r)))
  (let* ((r (sl:seq-concatenate (sl:dict :k 1) (sl:dict :k 2)))
         (items (multi03-list r)))
    (parachute:true (sl:ordered-dict-p r))
    (parachute:true (every (lambda (entry) (typep entry 'sl:map-entry)) items))
