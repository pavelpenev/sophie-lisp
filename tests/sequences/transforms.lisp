      (parachute:is = 4 (length pairs))
      (parachute:is equal '((1 10) (2 20)) (sort (subseq pairs 0 2) #'< :key #'first))
      (parachute:is equal '((3 30) (4 40)) (sort (subseq pairs 2) #'< :key #'first))))
  (let ((items (multi03-list (sl:seq-concatenate (sl:hash-set 1 2) (sl:hash-set 2 3)))))
    (parachute:is equal '(1 2) (sort (subseq items 0 2) #'<))
    (parachute:is equal '(2 3) (sort (subseq items 2) #'<)))
)

