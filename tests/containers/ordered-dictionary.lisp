;;;; Independent ordered storage/Seq tests. No ordered implementation consulted.
(in-package #:sophie-lisp.tests)

(defgeneric dict-keyword-probe (a &key known)
  (:method ((a t) &key known) (list a known)))

(defun dict-unknown-keywords-rejected-p ()
  "Whether the host's ordinary keyword-argument checking rejects unknown
keywords on generic functions. The spec subjects unrecognized keywords
(including the removed :SIGNAL) to ordinary CL keyword checking; SBCL and
CCL enforce it, while ECL's CLOS accepts unknown keywords, so the
removed-keyword rejection assertions run only where the host enforces
them."
  (handler-case (progn (dict-keyword-probe 1 :removed 2) nil)
    (program-error () t)))

(defun od-items (source &optional (limit 4096))
  (loop with view = source for i below limit until (sl:seq-emptyp view)
        collect (sl:seq-first view) do (setf view (sl:seq-rest view))
        finally (unless (sl:seq-emptyp view)
                  (parachute:true nil "OD-ITEMS exceeded its finite fixture bound"))))

(defun od-pairs (source)
  (mapcar (lambda (e) (list (sl:entry-key e) (sl:entry-value e))) (od-items source)))

(defun od-check (expected actual)
  ;; Three assertions; oracle is literal ordered pairs, not ordered EQUALS.
  (parachute:true (sl:ordered-dict-p actual))
  (parachute:is equal expected (od-pairs actual))
  (parachute:is = (length expected) (sl:dict-size actual)))

(defun od-fixture () (sl:ordered-dict 10 1 20 2 30 3 40 4))

(defclass od-key () ((id :initarg :id :reader od-key-id)))
(defclass od-subclass (sl:ordered-dict) ())
(defvar *od-key-calls* 0)
(defvar *od-key-exit* nil)
(defmethod sl:hash-code ((x od-key))
  (declare (ignore x)) (incf *od-key-calls*)
  (when (eq *od-key-exit* :hash) (throw 'od-exit :hash)) 71)
(defmethod sl:equals ((a od-key) (b od-key))
  (incf *od-key-calls*)
  (when (eq *od-key-exit* :equals) (throw 'od-exit :equals))
  (= (od-key-id a) (od-key-id b)))

(parachute:define-test ordered-dict.empty-construction-and-predicate
  (let ((empty (sl:ordered-dict)))
    (od-check nil empty)
    (parachute:true (sl:dictp empty))
    (parachute:true (sl:seqablep empty))
    (parachute:true (sl:seq-emptyp empty))
    (parachute:is = 0 (sl:seq-length empty))
    (parachute:false (typep empty 'sl:dict))
    (parachute:is eq #'sl:equals (sl:dict-test empty))
    (parachute:false (typep #'sl:ordered-dict 'generic-function))
    (parachute:false (typep #'sl:ordered-dict-p 'generic-function)))
  (dolist (x (list nil #() (sl:dict) (make-hash-table) (sl:hash-set)))
    (parachute:false (sl:ordered-dict-p x))))

(parachute:define-test ordered-dict.equal-key-replacement-and-order
  (let* ((a (copy-seq "same")) (b (copy-seq "same")) (v (list :value))
         (old (sl:ordered-dict a v :other nil))
         (new (sl:dict-set old b v)))
    (parachute:false (eq a b))
    (parachute:is eq a (sl:entry-key (sl:seq-first old)))
    (parachute:is eq b (sl:entry-key (sl:seq-first new)))
    (parachute:is eq v (sl:dict-ref new a))
    (od-check (list (list b v) '(:other nil)) new)
    (od-check (list '(:other nil) (list b v))
      (sl:dict-set (sl:dict-without new a) b v))
    (od-check (list (list b v) '(:other nil)) (sl:dict-without new :absent))))

(parachute:define-test ordered-dict.constructor-validation-and-duplicates
  (let ((key (make-instance 'od-key :id 1)) (*od-key-calls* 0))
    (parachute:fail (sl:ordered-dict key 1 :odd) program-error)
    (parachute:is = 0 *od-key-calls*))
  (parachute:fail (sl:ordered-dict :odd) program-error)
  (od-check '((1.0 :last) (:test eql) (nil nil))
    (sl:ordered-dict 1 :first :test 'eql 1.0 :last nil nil))
  (let* ((a (copy-seq "x")) (b (copy-seq "x"))
         (d (sl:ordered-dict a :old :middle 2 b :new)))
    (parachute:is eq b (sl:entry-key (sl:seq-first d)))
    (od-check '(("x" :new) (:middle 2)) d)))

(parachute:define-test ordered-dict.lookup-indexing-and-read-only
  (let ((d (sl:ordered-dict 9 :nine 0 nil 1 :one)) (default (list :default)))
    (parachute:is equal '(nil t) (multiple-value-list (sl:dict-ref d 0 default)))
    (parachute:is equal (list default nil) (multiple-value-list (sl:dict-ref d 7 default)))
    (parachute:is equal (list default nil) (multiple-value-list (sl:dict-ref d -1 default)))
    (parachute:is equal (list default nil) (multiple-value-list (sl:ref d -1 default)))
    (parachute:is = 9 (sl:entry-key (sl:seq-ref d 0)))
    (parachute:true (nth-value 1 (sl:seq-ref d 0)))
    (parachute:is equal (list default nil) (multiple-value-list (sl:seq-ref d 3 default)))
    (parachute:is = 1 (sl:entry-key (sl:seq-ref d -1)))
    (parachute:fail (sl:seq-ref d 1/2) type-error)
    (parachute:fail (setf (sl:dict-ref d 0) :changed) simple-error)
    (parachute:fail (setf (sl:dict-ref d :absent default) :changed) simple-error)
    (od-check '((9 :nine) (0 nil) (1 :one)) d)))

(parachute:define-test ordered-dict.persistence-and-lazy-rest
  (let* ((d (od-fixture)) (cursor (sl:seq-rest d))
         (first (sl:seq-first cursor))
         (new (sl:dict-set (sl:dict-without d 20) 50 5)))
    (parachute:true (sl:lazy-seq-p cursor))
    (parachute:false (sl:ordered-dict-p cursor))
    (parachute:is eq first (sl:seq-first cursor))
    (od-check '((10 1) (30 3) (40 4) (50 5)) new)
    (od-check '((10 1) (20 2) (30 3) (40 4)) d)
    (parachute:is equal '((20 2) (30 3) (40 4)) (od-pairs cursor))
    (parachute:is eq first (sl:seq-first cursor)))
  (parachute:is eq nil (sl:seq-rest (sl:ordered-dict))))
(parachute:define-test ordered-dict.subclass-update-class-preservation
  (let* ((source (change-class (sl:ordered-dict :first 1 :second 2) 'od-subclass))
         (set-result (sl:dict-set source :third 3))
         (without-result (sl:dict-without source :first)))
    (parachute:is eq (class-of source) (class-of set-result))
    (parachute:is eq (class-of source) (class-of without-result))
    (parachute:is = 3 (sl:dict-ref set-result :third))
    (parachute:false (nth-value 1 (sl:dict-ref without-result :first)))
    (parachute:is = 2 (sl:dict-size source))))

(parachute:define-test ordered-dict.callback-propagation-and-metadata
  (let* ((a (make-instance 'od-key :id 1)) (b (make-instance 'od-key :id 2))
         (alias (make-instance 'od-key :id 1)) (d (sl:ordered-dict a :a b :b)))
    (dolist (phase '(:hash :equals))
      (let ((*od-key-exit* phase))
        (parachute:is eq phase (catch 'od-exit (sl:dict-set d alias :lost) :returned))
        (parachute:is eq phase (catch 'od-exit (sl:dict-without d alias) :returned))
        (parachute:is eq phase (catch 'od-exit (sl:dict-ref d alias) :returned))))
    (let ((*od-key-calls* 0))
      (parachute:is = 2 (sl:dict-size d))
      (parachute:is = 2 (sl:seq-length d))
      (parachute:is eq #'sl:equals (sl:dict-test d))
      (parachute:true (sl:ordered-dict-p d))
      (parachute:is = 0 *od-key-calls*))
    (parachute:is eq a (sl:entry-key (sl:seq-first d)))
    (parachute:is eq alias (sl:entry-key (sl:seq-first (sl:dict-set d alias :new))))
    (parachute:is eq :a (sl:dict-ref d alias))
    (parachute:is eq :b (sl:dict-ref d b))
    (od-check (list (list b :b)) (sl:dict-without d alias))
    (od-check (list (list a :a) (list b :b)) d)))

(parachute:define-test ordered-dict.persistence-and-stored-order
  ;; Retained snapshots preserve their public contents and stored order.
  (let ((d (sl:ordered-dict)) (model nil) (versions nil))
    (dotimes (i 128)
      (setf d (sl:dict-set d i (+ i 1000))
            model (append model (list (list i (+ i 1000)))))
      (push (list d (copy-tree model)) versions))
    (dotimes (i 128)
      (let ((key (mod (* i 53) 128)))
        (setf d (sl:dict-without d key)
              model (remove key model :key #'first))
        (od-check model d)))
    (dolist (snapshot versions)
      (od-check (second snapshot) (first snapshot)))))

(parachute:define-test ordered-dict.printing-and-value-identity
  (dolist (d (list (sl:ordered-dict) (od-fixture)))
    (parachute:fail (write-to-string d :readably t) print-not-readable))
  (let* ((value (vector :before)) (d (sl:ordered-dict :value value)))
    (setf (aref value 0) :after)
    (parachute:is eq value (sl:dict-ref d :value))
    (parachute:is eq :after (aref (sl:entry-value (sl:seq-first d)) 0))))

(defun odv-relation (expected a b)
  (parachute:is eq expected (not (null (sl:equals a b))))
  (parachute:is eq expected (not (null (sl:equals b a))))
  (parachute:is eq (if expected :equal :unequal) (sl:compare a b))
  (parachute:is eq (if expected :equal :unequal) (sl:compare b a)))

(defun odv-hashes (a b)
  (let ((ha (sl:hash-code a)) (hb (sl:hash-code b)))
    (parachute:true (typep ha '(unsigned-byte 64)))
    (parachute:true (typep hb '(unsigned-byte 64)))
    (parachute:is = ha hb)))

(defclass odv-external () ((id :initarg :id :reader odv-id)))
(defvar *odv-visits* 0)
(defvar *odv-exit* nil)
(defmethod sl:equals ((a odv-external) (b odv-external)) (= (odv-id a) (odv-id b)))
(defmethod sl:hash-code ((x odv-external))
  (incf *odv-visits*)
  (case *odv-exit*
    (:throw (throw 'odv-exit :escaped))
    (:error (error "External hash condition")))
  (mod (odv-id x) 17))

(parachute:define-test ordered-dict-values.equality-and-hashing
  (odv-relation t (sl:ordered-dict) (sl:ordered-dict))
  (let ((a (sl:ordered-dict :a 1 :b 2)) (b (sl:ordered-dict :b 2 :a 1)))
    (odv-relation nil a b)
    (odv-relation nil a (sl:ordered-dict :a 2 :b 1))
    (odv-relation nil a (sl:ordered-dict :a 1))
    (odv-relation t a (sl:ordered-dict :a 1d0 :b #c(2.0 0.0)))
    (odv-hashes a (sl:ordered-dict :a 1.0 :b 2d0)))
  (let ((a (make-symbol "SAME")) (b (make-symbol "SAME")))
    (odv-relation nil (sl:ordered-dict :key a) (sl:ordered-dict :key b))))

(parachute:define-test ordered-dict-values.cross-type-inequality
  (dolist (empty '(nil t))
    (let* ((entry (sl:map-entry :a 1))
           (ordered (if empty (sl:ordered-dict) (sl:ordered-dict :a 1)))
           (table (make-hash-table)))
      (unless empty (setf (gethash :a table) 1))
      (dolist (other (list (if empty (sl:dict) (sl:dict :a 1)) table
                          (sl:plist-dict-view (unless empty '(:a 1)))
                          (if empty (sl:hash-set) (sl:hash-set entry))
                          (unless empty (list entry))
                          (if empty #() (vector entry))
                          (sl:lazy-seq (unless empty (sl:lazy-cons entry nil)))))
        (odv-relation nil ordered other)))))

(parachute:define-test ordered-dict-values.structural-equality-and-nesting
  (let* ((a (sl:ordered-dict "text" nil 1 #(#\a #\b)))
         (b (sl:ordered-dict #(#\t #\e #\x #\t) (sl:lazy-seq nil) 1d0 "ab")))
    (odv-relation t a b)
    (odv-hashes a b)
    (parachute:is equal '(:found t) (multiple-value-list (sl:dict-ref (sl:dict a :found) b)))
    (parachute:is equal '(:found t)
      (multiple-value-list (sl:dict-ref (sl:ordered-dict a :found) b)))
    (dolist (wrap (list #'list #'vector (lambda (x) (sl:map-entry :nested x))))
      (let ((left (funcall wrap a)) (right (funcall wrap b)))
        (odv-hashes left right)
        (parachute:is equal '(:hit t)
          (multiple-value-list (sl:dict-ref (sl:dict left :hit) right)))))
    (parachute:is = 1 (sl:seq-length (sl:hash-set a b)))))

(parachute:define-test ordered-dict-values.content-equality-across-history
  ;; Different insertion histories, same logical content, same hash.
  (let ((a (sl:ordered-dict)) (b (sl:ordered-dict)))
    (dotimes (i 40) (setf a (sl:dict-set a i i) b (sl:dict-set b (- i 100) :discard)))
    (dotimes (i 40) (setf b (sl:dict-without b (- i 100))))
    (dotimes (i 40) (setf b (sl:dict-set b (float i 1d0) (float i 1d0))))
    (odv-relation t a b) (odv-hashes a b)
    (let ((shared (vector a)))
      (odv-hashes (sl:ordered-dict :x shared :y shared)
                 (sl:ordered-dict :x (vector b) :y (vector b)))))
  (dotimes (depth 5)
    (let ((a nil) (b (sl:lazy-seq nil)))
      (dotimes (i depth)
        (setf a (sl:ordered-dict :child (vector a))
              b (sl:ordered-dict :child (vector b))))
      (odv-hashes a b))))

(parachute:define-test ordered-dict-values.cyclic-value-hashing
  ;; One- and two-node finite graphs have identical infinite unfoldings.
  ;; Close only value vectors, never mutate resident keys or sealed slots.
  (let* ((edge1 (vector nil)) (one (sl:ordered-dict :next edge1))
         (edge2 (vector nil)) (edge3 (vector nil))
         (two-a (sl:ordered-dict :next edge2)) (two-b (sl:ordered-dict :next edge3)))
    (setf (aref edge1 0) one (aref edge2 0) two-b (aref edge3 0) two-a)
    (odv-hashes one one)
    (odv-hashes one two-a)
    (odv-hashes two-a two-b))
  (let ((cycle (list :cycle)))
    (setf (cdr cycle) cycle)
    (let ((d (sl:ordered-dict :cycle cycle))) (odv-hashes d d))))

(parachute:define-test ordered-dict-values.mutable-and-external-value-hashing
  (let* ((value (vector 1)) (d (sl:ordered-dict :mutable value)))
    (sl:hash-code d)
    (setf (aref value 0) 2)
    (odv-relation t d (sl:ordered-dict :mutable #(2d0)))
    (odv-hashes d (sl:ordered-dict :mutable #(2.0))))
  (let* ((a (sl:ordered-dict :external (make-instance 'odv-external :id 7)))
         (b (sl:ordered-dict :external (make-instance 'odv-external :id 7)))
         (expected (sl:hash-code b)))
    (dolist (mode '(:throw :error))
      (let ((*odv-exit* mode))
        (if (eq mode :throw)
            (parachute:is eq :escaped (catch 'odv-exit (sl:hash-code a) :returned))
            (parachute:fail (sl:hash-code a) simple-error)))
      (parachute:is = expected (sl:hash-code a)))
    (let ((*odv-visits* 0))
      (odv-hashes a b)
      (parachute:true (plusp *odv-visits*)))
    (odv-relation t a b)))

(parachute:define-test ordered-dict-values.short-circuit-comparison-and-hash-range
  ;; Decisive prefix must not force an irrelevant value tail.
  (let ((tail (sl:lazy-seq (error "Irrelevant ordered comparison tail"))))
    (odv-relation nil (sl:ordered-dict :first 1 :later tail)
                       (sl:ordered-dict :first 2 :later tail)))
  ;; Unequal values are permitted to collide, but hashes retain their range.
  (let ((hashes (loop for i below 128 collect (sl:hash-code (sl:ordered-dict :key i)))))
    (parachute:true (every (lambda (h) (typep h '(unsigned-byte 64))) hashes))))

(defclass od-retry-key () ((fail :initform t :accessor od-retry-fail)))
(defmethod sl:hash-code ((x od-retry-key))
  (when (od-retry-fail x)
    (setf (od-retry-fail x) nil) (throw 'od-retry :escaped))
  101)

(parachute:define-test ordered-dict-collect.accumulation-and-duplicate-replacement
  (dolist (target (list (find-class 'sl:ordered-dict) (sl:ordered-dict :ignored :old)))
    (let* ((c (sl:make-collector-for target))
           (a (copy-seq "x")) (b (copy-seq "x")) (v (list :v)))
      (dolist (e (list (sl:map-entry a v) (sl:map-entry :middle nil) (sl:map-entry b v)))
        (parachute:is eq c (sl:collector-accumulate c e)))
      (let ((r (sl:collector-result c)))
        (od-check (list (list b v) '(:middle nil)) r)
        (parachute:is eq b (sl:entry-key (sl:seq-first r)))
        (parachute:is eq v (sl:dict-ref r a))
        (parachute:is eq #'sl:equals (sl:dict-test r))
        (parachute:is eq r (sl:collector-result c))
        (od-check nil (sl:collector-result (sl:make-collector-for r)))))))

(parachute:define-test ordered-dict-collect.invalid-entries-and-options
  (dolist (target (list (find-class 'sl:ordered-dict) (sl:ordered-dict)))
    (let ((c (sl:make-collector-for target)))
      (sl:collector-accumulate c (sl:map-entry :before 1))
      (dolist (bad (list nil :atom '(a . b) '(a b) #(a b)))
        (parachute:fail (sl:collector-accumulate c bad) type-error))
      (sl:collector-accumulate c (sl:map-entry nil nil))
      (od-check '((:before 1) (nil nil)) (sl:collector-result c)))
    (parachute:fail (sl:make-collector-for target :test #'sl:equals) program-error)
    (parachute:fail (sl:make-collector-for target :unknown t) program-error)))

(parachute:define-test ordered-dict-collect.bulk-and-lazy-source
  (let* ((prototype (sl:ordered-dict :ignored :old))
         (a (copy-seq "a")) (b (copy-seq "a"))
         (entries (vector (sl:map-entry a :old) (sl:map-entry :b 2) (sl:map-entry b :last))))
    (dolist (test (list 'eql #'eql #'sl:equals))
      (let ((r (sl:dict-collect prototype entries :test test)))
        (od-check '(("a" :last) (:b 2)) r)
        (parachute:is eq #'sl:equals (sl:dict-test r))
        (parachute:is eq b (sl:entry-key (sl:seq-first r)))))
    (od-check '((:ignored :old)) prototype)
    (od-check nil (sl:dict-collect prototype nil))
    (parachute:fail (sl:dict-collect prototype (list (sl:map-entry :ok 1) nil)) type-error)
    ;; The removed :UNKNOWN keyword is subject to ordinary CL keyword
    ;; checking; ECL's CLOS accepts unknown GF keywords, so the rejection is
    ;; asserted only where the host enforces it.
    (when (dict-unknown-keywords-rejected-p)
      (parachute:fail (sl:dict-collect prototype nil :unknown t) program-error)))
  (let ((calls 0))
    (let ((r (sl:dict-collect (sl:ordered-dict)
               (sl:lazy-seq (progn (incf calls) (sl:seq-into 'sl:lazy-seq (list (sl:map-entry :a 1))))))))
      (parachute:is = 1 calls)
      (od-check '((:a 1)) r))))

(parachute:define-test ordered-dict-collect.retry-after-finalization-failure
  ;; Fault only an external key before residency. Accumulation buffers entries;
  ;; an unsuccessful finalization must leave a complete retryable batch.
  (let* ((key (make-instance 'od-retry-key))
         (c (sl:make-collector-for (find-class 'sl:ordered-dict))))
    (dolist (e (list (sl:map-entry :before 1) (sl:map-entry key 2) (sl:map-entry :after 3)))
      (parachute:is eq c (sl:collector-accumulate c e)))
    (parachute:true (od-retry-fail key))
    (parachute:is eq :escaped (catch 'od-retry (sl:collector-result c) :returned))
    (let ((r (sl:collector-result c)))
      (od-check (list '(:before 1) (list key 2) '(:after 3)) r)
      (parachute:is eq r (sl:collector-result c))
      (parachute:is eq r (sl:collector-result c)))))

(parachute:define-test ordered-dict-collect.bulk-stored-order
  (let* ((entries (loop for i below 257 collect (sl:map-entry i i)))
         (r (sl:dict-collect (sl:ordered-dict :ignored 0) entries)))
    (od-check (loop for i below 257 collect (list i i)) r)))

(defun ods-value (entry) (sl:entry-value entry))
(defun ods-low (entry) (< (ods-value entry) 3))
(defun ods-same-value (a b) (= (ods-value a) (ods-value b)))
(defun ods-pieces (expected outer)
  (parachute:true (sl:lazy-seq-p outer))
  (let ((pieces (od-items outer)))
    (parachute:is = (length expected) (length pieces))
    (loop for pairs in expected for piece in pieces do (od-check pairs piece))))

(parachute:define-test ordered-dict-seq.map-duplicate-keys-and-validation
  ;; MAP: eager, strict, duplicates retain first position/latest association.
  (let ((calls nil) (source (od-fixture)))
    (let ((r (sl:seq-map (lambda (e) (push (ods-value e) calls)
                          (sl:map-entry (mod (ods-value e) 2) (ods-value e))) source)))
      (parachute:is equal '(4 3 2 1) calls)
      (od-check '((1 3) (0 4)) r)
      (od-check '((10 1) (20 2) (30 3) (40 4)) source)))
  (dolist (bad (list nil 7 '(a b) #(a b)))
    (parachute:fail (sl:seq-map (constantly bad) (od-fixture)) type-error))
  (od-check nil (sl:seq-map (lambda (e) (declare (ignore e)) (error "empty map"))
                          (sl:ordered-dict)))
  (let* ((a (copy-seq "key")) (b (copy-seq "key")) (keys (list a b))
         (r (sl:seq-map (lambda (e) (sl:map-entry (pop keys) (ods-value e)))
                        (sl:ordered-dict :a 1 :b 2))))
    (parachute:is eq b (sl:entry-key (sl:seq-first r)))
    (od-check '(("key" 2)) r)))

(parachute:define-test ordered-dict-seq.map-indexed-source-positions
  ;; MAP-INDEXED indexes the original source, not resident output cardinality.
  (let ((seen nil))
    (let ((r (sl:seq-map-indexed
              (lambda (i e) (push (list i (ods-value e)) seen) (sl:map-entry :same i))
              (od-fixture))))
      (parachute:is equal '((3 4) (2 3) (1 2) (0 1)) seen)
      (od-check '((:same 3)) r)))
  (parachute:fail (sl:seq-map-indexed (lambda (i e) (declare (ignore i e)) nil)
                                    (od-fixture)) type-error)
  (od-check nil (sl:seq-map-indexed (lambda (i e) (declare (ignore i e)) :unused)
                                   (sl:ordered-dict)))
  (let ((calls 0))
    (parachute:fail (sl:seq-map (lambda (e) (declare (ignore e))
                                (incf calls) (error "callback at call time"))
                              (od-fixture)) simple-error)
    (parachute:is = 1 calls)))

(parachute:define-test ordered-dict-seq.keep-nil-values
  ;; KEEP omits NIL, not entries whose value happens to be NIL.
  (let ((calls 0))
    (od-check '((20 nil) (40 nil))
      (sl:seq-keep (lambda (e) (incf calls)
                     (when (evenp (ods-value e)) (sl:map-entry (sl:entry-key e) nil)))
                   (od-fixture)))
    (parachute:is = 4 calls))
  (od-check nil (sl:seq-keep (constantly nil) (od-fixture)))
  (od-check nil (sl:seq-keep #'identity (sl:ordered-dict)))
  (parachute:fail (sl:seq-keep (constantly :bad) (od-fixture)) type-error))

(parachute:define-test ordered-dict-seq.substitute-emissions-and-duplicates
  ;; SUBSTITUTE/-IF validate actual emissions, never an unused NEWITEM.
  (let ((d (od-fixture)))
    (od-check '((10 1) (20 2) (30 3) (40 4))
      (sl:seq-substitute :bad 99 d :key #'ods-value))
    (od-check '((10 1) (20 2) (30 3) (40 4))
      (sl:seq-substitute-if :bad (constantly t) d :count 0))
    (parachute:fail (sl:seq-substitute nil 2 d :key #'ods-value) type-error)
    (parachute:fail (sl:seq-substitute-if nil #'ods-low d) type-error)
    (od-check '((10 9) (30 3) (40 4))
      (sl:seq-substitute (sl:map-entry 10 9) 2 d :key #'ods-value))
    (od-check '((40 4) (20 2) (30 3))
      (sl:seq-substitute (sl:map-entry 40 9) 1 d :key #'ods-value))
    (od-check '((10 1) (20 2) (30 3) (50 5))
      (sl:seq-substitute-if (sl:map-entry 50 5) (constantly t) d :from-end t :count 1))))

(parachute:define-test ordered-dict-seq.mapcat-flattening-and-validation
  ;; MAPCAT flattens seqables before uniqueness reconstruction.
  (let ((calls 0))
    (od-check '((:same 4) (10 1) (20 2) (30 3) (40 4))
      (sl:seq-mapcat (lambda (e) (incf calls)
                       (list (sl:map-entry :same (ods-value e)) e)) (od-fixture)))
    (parachute:is = 4 calls))
  (od-check nil (sl:seq-mapcat (constantly nil) (od-fixture)))
  (od-check nil (sl:seq-mapcat #'identity (sl:ordered-dict)))
  (parachute:fail (sl:seq-mapcat (constantly (list nil)) (od-fixture)) type-error)
  (parachute:fail (sl:seq-mapcat #'identity (od-fixture)) type-error))

(parachute:define-test ordered-dict-seq.reductions-states-and-validation
  ;; REDUCTIONS emits states, whose count may exceed the number of keys.
  (let ((seen nil))
    (od-check '((:sum 10))
      (sl:seq-reductions (lambda (a e) (push (list (ods-value a) (ods-value e)) seen)
                           (sl:map-entry :sum (+ (ods-value a) (ods-value e))))
                         (od-fixture) :initial-value (sl:map-entry :sum 0)))
    (parachute:is equal '((6 4) (3 3) (1 2) (0 1)) seen))
  (od-check '((10 1) (:sum 10))
    (sl:seq-reductions (lambda (a e) (sl:map-entry :sum (+ (ods-value a) (ods-value e))))
                       (od-fixture)))
  (od-check nil (sl:seq-reductions #'identity (sl:ordered-dict)))
  (od-check '((:initial nil))
    (sl:seq-reductions #'identity (sl:ordered-dict) :initial-value (sl:map-entry :initial nil)))
  (parachute:fail (sl:seq-reductions #'identity (sl:ordered-dict) :initial-value nil) type-error)
  (parachute:fail (sl:seq-reductions (lambda (a e) (declare (ignore a e)) 42)
                                   (od-fixture)) type-error))

(parachute:define-test ordered-dict-seq.filter-remove-regions-and-counts
  ;; FILTER omits outside the region; REMOVE retains outside it.
  (let ((d (od-fixture)) (calls nil))
    (od-check '((20 2) (30 3))
      (sl:seq-filter (lambda (v) (push v calls) t) d :key #'ods-value :start 1 :end 3))
    (parachute:is equal '(3 2) calls)
    (od-check '((10 1) (40 4)) (sl:seq-remove-if (constantly t) d :start 1 :end 3))
    (od-check '((10 1) (30 3) (40 4)) (sl:seq-remove 2 d :test #'= :key #'ods-value))
    (od-check '((40 4)) (sl:seq-filter (constantly t) d :count 1 :from-end t))
    (od-check nil (sl:seq-filter (lambda (e) (declare (ignore e)) (error "count zero"))
                                d :count 0))
    (od-check '((10 1) (20 2) (30 3) (40 4))
      (sl:seq-remove-if (lambda (e) (declare (ignore e)) (error "count zero")) d :count 0))))

(parachute:define-test ordered-dict-seq.positional-selections-and-validation
  ;; TAKE/DROP/SUBSEQ/TAKE-NTH select positions, never integer dictionary keys.
  (let ((d (od-fixture)))
    (od-check '((10 1) (20 2)) (sl:seq-take 2 d))
    (od-check '((30 3) (40 4)) (sl:seq-drop 2 d))
    (od-check '((20 2) (30 3)) (sl:seq-subseq d 1 3))
    (od-check '((10 1) (30 3)) (sl:seq-take-nth 2 d))
    (od-check nil (sl:seq-take 0 d))
    (od-check nil (sl:seq-drop 99 d))
    (od-check nil (sl:seq-subseq d 2 2))
    (parachute:fail (sl:seq-take -1 d) type-error)
    (parachute:fail (sl:seq-drop 1/2 d) type-error)
    (parachute:fail (sl:seq-take-nth 0 d) program-error)))

(parachute:define-test ordered-dict-seq.while-and-trim-left-boundaries
  ;; WHILE and TRIM-LEFT stop calling their predicate at the boundary.
  (dolist (fn (list #'sl:seq-take-while #'sl:seq-drop-while))
    (let ((calls nil))
      (let ((r (funcall fn (lambda (e) (push (ods-value e) calls) (ods-low e)) (od-fixture))))
        (parachute:is equal '(3 2 1) calls)
        (od-check (if (eq fn #'sl:seq-take-while) '((10 1) (20 2)) '((30 3) (40 4))) r))))
  (let ((calls nil))
    (od-check '((30 3) (40 4))
      (sl:seq-trim-left (od-fixture) :predicate
                        (lambda (e) (push (ods-value e) calls) (ods-low e))))
    (parachute:is equal '(3 2 1) calls))
  (parachute:fail (sl:seq-trim-left (od-fixture)) program-error))

(parachute:define-test ordered-dict-seq.duplicate-removal-by-projection
  ;; Duplicate removal compares entries/projections, not the dictionary keys.
  (let ((d (sl:ordered-dict :a 1 :b 1 :c 2 :d 1)))
    (od-check '((:a 1) (:c 2)) (sl:seq-remove-duplicates d :key #'ods-value :test #'=))
    (od-check '((:c 2) (:d 1))
      (sl:seq-remove-duplicates d :key #'ods-value :test #'= :from-end t))
    (od-check '((:a 1) (:c 2) (:d 1)) (sl:seq-dedupe d :test #'ods-same-value)))
  ;; Nontransitive test distinguishes immediately preceding input from last emitted.
  (od-check '((10 1))
    (sl:seq-dedupe (od-fixture)
      :test (lambda (a b) (= 1 (- (ods-value b) (ods-value a)))))))

(parachute:define-test ordered-dict-seq.reordering-and-right-trimming
  ;; Reordering creates the new stored order, including subsequent novel insertions.
  (let* ((d (od-fixture)) (r (sl:seq-reverse d)))
    (od-check '((40 4) (30 3) (20 2) (10 1)) r)
    (od-check '((40 4) (30 3) (20 2) (10 1) (50 5)) (sl:dict-set r 50 5))
    (od-check '((40 4) (30 3) (20 2) (10 1)) (sl:seq-sort d :test #'> :key #'ods-value))
    (od-check '((30 3) (40 4)) (sl:seq-take-last 2 d))
    (od-check nil (sl:seq-take-last 0 d))
    (od-check '((10 1) (20 2))
      (sl:seq-trim-right d :predicate (lambda (e) (> (ods-value e) 2))))
    (od-check '((20 2) (30 3))
      (sl:seq-trim d :predicate (lambda (e) (member (ods-value e) '(1 4)))))
    (parachute:fail (sl:seq-trim-right d) program-error)
    (parachute:fail (sl:seq-trim d :predicate nil) program-error))
  (od-check '((:b 1) (:d 1) (:a 2) (:c 2))
    (sl:seq-stable-sort (sl:ordered-dict :a 2 :b 1 :c 2 :d 1) :test #'< :key #'ods-value)))

(parachute:define-test ordered-dict-seq.empty-reconstruction-type
  ;; Every reconstruction selection/reordering family preserves the empty type.
  (let ((d (sl:ordered-dict)))
    (dolist (r (list (sl:seq-filter #'identity d) (sl:seq-remove :x d)
                    (sl:seq-remove-if #'identity d) (sl:seq-substitute :bad :x d)
                    (sl:seq-substitute-if :bad #'identity d)
                    (sl:seq-take 2 d) (sl:seq-drop 2 d)
                    (sl:seq-take-while #'identity d) (sl:seq-drop-while #'identity d)
                    (sl:seq-subseq d 0 0) (sl:seq-take-nth 2 d)
                    (sl:seq-remove-duplicates d) (sl:seq-dedupe d)
                    (sl:seq-trim-left d :predicate #'identity) (sl:seq-reverse d)
                    (sl:seq-sort d :test #'< :key #'ods-value)
                    (sl:seq-stable-sort d :test #'< :key #'ods-value) (sl:seq-take-last 2 d)
                    (sl:seq-trim-right d :predicate #'identity)
                    (sl:seq-trim d :predicate #'identity)
                    (sl:seq-concatenate d d) (sl:seq-interleave d d)
                    (sl:seq-map #'list d d) (sl:seq-into 'sl:ordered-dict nil)))
      (od-check nil r))))

(parachute:define-test ordered-dict-seq.homogeneous-multi-source-operations
  ;; Homogeneous multi-source: serial vs complete rounds; shortest wins.
  (let ((a (sl:ordered-dict :a 1 :b 2 :c 3)) (b (sl:ordered-dict :b 20 :d 4)))
    (od-check '((:a 1) (:b 20) (:c 3) (:d 4)) (sl:seq-concatenate a b))
    (od-check '((:a 1) (:b 2) (:d 4)) (sl:seq-interleave a b))
    (let ((calls nil))
      (od-check '((:sum 6))
        (sl:seq-map (lambda (x y) (push (list (ods-value x) (ods-value y)) calls)
                      (sl:map-entry :sum (+ (ods-value x) (ods-value y)))) a b))
      (parachute:is equal '((2 4) (1 20)) calls))
    (parachute:fail (sl:seq-map (lambda (x y) (declare (ignore x y)) 99) a b) type-error))
  (parachute:is eq nil (sl:seq-interleave))
  (od-check nil (sl:seq-interleave (od-fixture) (sl:ordered-dict))))

(parachute:define-test ordered-dict-seq.heterogeneous-lazy-operations
  ;; Heterogeneous concrete representation is lazy, but callbacks stay eager.
  (dolist (other (list '(10 20) #(10 20)))
    (let ((calls 0))
      (let ((r (sl:seq-map (lambda (e n) (incf calls) (+ (ods-value e) n)) (od-fixture) other)))
        (parachute:is = 2 calls)
        (parachute:true (sl:lazy-seq-p r))
        (parachute:is equal '(11 22) (od-items r))
        (parachute:is = 2 calls))))
  (let ((calls 0) (forces 0))
    (let ((r (sl:seq-map (lambda (e n) (incf calls) (+ (ods-value e) n))
                         (od-fixture) (sl:lazy-seq (progn (incf forces) (sl:lazy-cons 10 (sl:lazy-cons 20 nil)))))))
      (parachute:is = 0 calls) (parachute:is = 0 forces)
      (parachute:is equal '(11 22) (od-items r))
      (parachute:is = 2 calls) (parachute:is = 1 forces)))
  (let* ((d (sl:ordered-dict :a 1)) (e (sl:map-entry :b 2)))
    (dolist (r (list (sl:seq-concatenate d (list e)) (sl:seq-interleave d (vector e))))
      (parachute:true (sl:lazy-seq-p r))
      (parachute:is equal '((:a 1) (:b 2)) (od-pairs r)))))

(parachute:define-test ordered-dict-seq.split-boundaries-and-typed-empties
  ;; SPLIT: deferred predicate; adjacent/trailing boundaries retain typed empties.
  (let ((calls nil))
    (let ((r (sl:seq-split (od-fixture) :predicate
                           (lambda (e) (push (ods-value e) calls) (/= (ods-value e) 3)))))
      (parachute:is eq nil calls)
      (parachute:true (sl:lazy-seq-p r))
      (let ((first (sl:seq-first r)))
        (od-check nil first)
        (parachute:is eq first (sl:seq-first r)))
      (ods-pieces '(nil nil ((30 3)) nil) r)
      (parachute:is equal '(4 3 2 1) calls)))
  (ods-pieces '(((10 1)) ((40 4)))
    (sl:seq-split (od-fixture) :delimiter (list (sl:map-entry 20 2) (sl:map-entry 30 3))))
  (ods-pieces '(nil) (sl:seq-split (sl:ordered-dict) :predicate #'identity)))

(parachute:define-test ordered-dict-seq.split-at-and-split-with-laziness
  ;; SPLIT-AT and SPLIT-WITH: lazy pair, individually memoized ordered pieces.
  (dolist (n '(0 2 99))
    (let* ((r (sl:seq-split-at n (od-fixture))) (prefix (sl:seq-first r))
           (rest (sl:seq-rest r)) (suffix (sl:seq-first rest)))
      (parachute:true (sl:lazy-seq-p r))
      (parachute:is eq prefix (sl:seq-first r))
      (parachute:is eq suffix (sl:seq-first rest))
      (od-check (case n (0 nil) (2 '((10 1) (20 2)))
                       (t '((10 1) (20 2) (30 3) (40 4)))) prefix)
      (od-check (case n (0 '((10 1) (20 2) (30 3) (40 4)))
                       (2 '((30 3) (40 4)))) suffix)))
  (let ((calls nil))
    (let ((r (sl:seq-split-with (lambda (e) (push (ods-value e) calls) (ods-low e)) (od-fixture))))
      (parachute:is eq nil calls)
      (let ((prefix (sl:seq-first r)))
        (od-check '((10 1) (20 2)) prefix)
        (parachute:is equal '(3 2 1) calls)
        (parachute:is eq prefix (sl:seq-first r)))
      (od-check '((30 3) (40 4)) (sl:seq-first (sl:seq-rest r)))
      (parachute:is equal '(3 2 1) calls)))
  (ods-pieces '(nil nil) (sl:seq-split-with #'identity (sl:ordered-dict))))

(parachute:define-test ordered-dict-seq.boundary-callback-retry
  ;; Retry a boundary predicate, preserving each prior successful invocation.
  (dolist (kind '(:split :with :by))
    (let ((attempts 0) (successes nil))
      (flet ((callback (e)
               (when (= (ods-value e) 2)
                 (incf attempts) (when (= attempts 1) (error "retry boundary")))
               (push (ods-value e) successes)
               (case kind (:split nil) (:with t) (:by :same))))
        (let ((r (ecase kind
                   (:split (sl:seq-split (od-fixture) :predicate #'callback))
                   (:with (sl:seq-split-with #'callback (od-fixture)))
                   (:by (sl:seq-partition-by #'callback (od-fixture))))))
          (parachute:is eq nil successes)
          (parachute:fail (sl:seq-first r) simple-error)
          (parachute:is equal '(1) successes)
          (let ((piece (sl:seq-first r)))
            (od-check '((10 1) (20 2) (30 3) (40 4)) piece)
            (parachute:is eq piece (sl:seq-first r)))
          (parachute:is = 2 attempts)
          (parachute:is equal '(4 3 2 1) successes))))))

(parachute:define-test ordered-dict-seq.partition-overlap-gaps-and-padding
  ;; PARTITION: overlap/gaps, no extra empty chunks, padding emission cardinality.
  (ods-pieces '(((10 1) (20 2)) ((30 3) (40 4)))
    (sl:seq-partition 2 (od-fixture)))
  (ods-pieces '(((10 1) (20 2) (30 3)) ((20 2) (30 3) (40 4)) ((30 3) (40 4)))
    (sl:seq-partition 3 (od-fixture) :step 1 :pad t))
  (ods-pieces '(((10 1) (20 2)) ((40 4)))
    (sl:seq-partition 2 (od-fixture) :step 3 :pad t))
  (ods-pieces '(((10 1) (20 2) (30 3)) ((40 9) (50 5)))
    (sl:seq-partition 3 (od-fixture) :pad (list (sl:map-entry 40 9) (sl:map-entry 50 5))))
  (ods-pieces nil (sl:seq-partition 3 (sl:ordered-dict) :pad t))
  (let ((pad-calls 0))
    (ods-pieces '(((10 1) (20 2)) ((30 3) (40 4)))
      (sl:seq-partition 2 (od-fixture) :pad (sl:lazy-seq (progn (incf pad-calls) (error "unused pad")))))
    (parachute:is = 0 pad-calls))
  (let* ((r (sl:seq-partition 3 (od-fixture) :pad '(nil)))
         (first (sl:seq-first r)) (rest (sl:seq-rest r)))
    (od-check '((10 1) (20 2) (30 3)) first)
    (parachute:fail (sl:seq-first rest) type-error)
    (parachute:fail (sl:seq-first rest) type-error)
    (parachute:is eq first (sl:seq-first r))))

(parachute:define-test ordered-dict-seq.partition-retry-and-partition-by
  ;; External padding key faults at finalization, before residency; no sealed probes.
  (let* ((key (make-instance 'od-retry-key))
         (r (sl:seq-partition 3 (sl:ordered-dict :source 1)
                              :pad (list (sl:map-entry :pad 2) (sl:map-entry key 3)))))
    (parachute:true (od-retry-fail key))
    (parachute:is eq :escaped (catch 'od-retry (sl:seq-first r) :returned))
    (let ((piece (sl:seq-first r)))
      (od-check (list '(:source 1) '(:pad 2) (list key 3)) piece)
      (parachute:is eq piece (sl:seq-first r))
      (parachute:true (sl:seq-emptyp (sl:seq-rest r)))))
  (let ((calls nil))
    (let ((r (sl:seq-partition-by (lambda (e) (push (ods-value e) calls) (ods-value e))
                                  (sl:ordered-dict :a 1 :b 1 :c 2 :d 1))))
      (parachute:is eq nil calls)
      (ods-pieces '(((:a 1) (:b 1)) ((:c 2)) ((:d 1))) r)
      (parachute:is equal '(1 2 1 1) calls))))

(parachute:define-test ordered-dict-seq.member-drop-last-and-tree-laziness
  ;; Explicit lazy exceptions: MEMBER search is eager, TREE callbacks are deferred.
  (let ((calls 0))
    (let ((r (sl:seq-member 3 (od-fixture) :key (lambda (e) (incf calls) (ods-value e)))))
      (parachute:is = 3 calls)
      (parachute:true (sl:lazy-seq-p r))
      (parachute:is equal '((30 3) (40 4)) (od-pairs r))
      (parachute:is = 3 calls)))
  (parachute:is eq nil (sl:seq-member 99 (od-fixture) :key #'ods-value))
  (dolist (n '(0 2 99))
    (let ((r (sl:seq-drop-last n (od-fixture))))
      (parachute:true (sl:lazy-seq-p r))
      (parachute:is equal (case n (0 '((10 1) (20 2) (30 3) (40 4))) (2 '((10 1) (20 2))))
                          (od-pairs r))))
  (let ((branches 0) (children 0) (d (sl:ordered-dict :a 1 :b 2)))
    (let ((r (sl:seq-tree-seq (lambda (x) (incf branches) (eq x d))
                             (lambda (x) (incf children) x) d)))
      (parachute:is = 0 branches) (parachute:is = 0 children)
      (parachute:true (sl:lazy-seq-p r))
      (let ((nodes (od-items r)))
        (parachute:is eq d (first nodes))
        (parachute:is equal '((:a 1) (:b 2)) (od-pairs (rest nodes))))
      (parachute:is = 3 branches) (parachute:is = 1 children))))

(parachute:define-test ordered-dict-seq.scalar-query-positions
  ;; Entry and positional scalar queries do not reconstruct dictionaries.
  (let ((d (sl:ordered-dict 90 1 0 2 1 1 70 3)))
    (parachute:is = 70 (sl:entry-key (sl:seq-last d)))
    (parachute:is = 90 (sl:entry-key (sl:seq-find 1 d :key #'ods-value)))
    (parachute:is = 1 (sl:entry-key (sl:seq-find 1 d :key #'ods-value :from-end t)))
    (parachute:is = 0 (sl:entry-key (sl:seq-find-if #'evenp d :key #'ods-value)))
    (parachute:is = 1 (sl:entry-key (sl:seq-find-if #'oddp d :key #'ods-value :end 3 :from-end t)))
    (parachute:is = 2 (sl:seq-position 1 d :key #'ods-value :start 1))
    (parachute:is = 2 (sl:seq-position 1 d :key #'ods-value :from-end t))
    (parachute:is = 3 (sl:seq-position-if #'oddp d :key #'ods-value :from-end t))
    (parachute:is = 2 (sl:seq-count 1 d :key #'ods-value))
    (parachute:is = 2 (sl:seq-count-if #'oddp d :key #'ods-value :start 1 :from-end t))
    (parachute:is eq nil (sl:seq-find 99 d :key #'ods-value))
    (parachute:is eq nil (sl:seq-position 99 d :key #'ods-value))
    (parachute:is = 3 (ods-value (sl:seq-max d :key #'ods-value)))
    (parachute:is = 1 (ods-value (sl:seq-min d :key #'ods-value))))
  (let ((d (sl:ordered-dict)))
    (parachute:fail (sl:seq-last d) simple-error)
    (parachute:fail (sl:seq-min d) simple-error)
    (parachute:fail (sl:seq-max d) simple-error)
    (parachute:is eq nil (sl:seq-min d :default nil))
    (parachute:is eq :empty (sl:seq-max d :default :empty))))

(parachute:define-test ordered-dict-seq.search-mismatch-and-reduce
  ;; SEARCH forces pattern now; MISMATCH returns source1's absolute index.
  (let ((forces 0) (d (od-fixture)))
    (parachute:is = 1
      (sl:seq-search (sl:lazy-seq (progn (incf forces) (sl:seq-into 'sl:lazy-seq (list (sl:map-entry 20 2) (sl:map-entry 30 3))))) d))
    (parachute:is = 1 forces)
    (parachute:is = 1 (sl:seq-search (sl:ordered-dict 20 2 30 3) d :start2 1))
    (parachute:is eq nil (sl:seq-search (sl:ordered-dict :absent 9) d))
    (parachute:is eq nil (sl:seq-mismatch d (od-fixture)))
    (parachute:is = 2 (sl:seq-mismatch d (sl:ordered-dict 10 1 20 2 30 99 40 4))))
  (let ((calls 0))
    (parachute:is = 10 (sl:seq-reduce (lambda (a b) (incf calls) (+ a b))
                                     (od-fixture) :key #'ods-value :initial-value 0))
    (parachute:is = 4 calls))
  (parachute:is = -2 (sl:seq-reduce #'- (od-fixture) :key #'ods-value :from-end t))
  (parachute:is eq nil (sl:seq-reduce #'list (sl:ordered-dict) :initial-value nil))
  (parachute:fail (sl:seq-reduce #'+ (sl:ordered-dict)) simple-error))

(parachute:define-test ordered-dict-seq.predicate-query-short-circuiting
  ;; Predicate queries short-circuit and never demand an incomplete tuple.
  (let ((calls 0))
    (parachute:false (sl:seq-every (lambda (e) (incf calls) (ods-low e)) (od-fixture)))
    (parachute:is = 3 calls))
  (let ((calls 0))
    (parachute:is eq :hit (sl:seq-some (lambda (e) (incf calls) (when (= 2 (ods-value e)) :hit))
                                      (od-fixture)))
    (parachute:is = 2 calls))
  (parachute:true (sl:seq-notevery #'ods-low (od-fixture)))
  (parachute:true (sl:seq-notany (lambda (e) (> (ods-value e) 9)) (od-fixture)))
  (dolist (fn (list #'sl:seq-every #'sl:seq-some #'sl:seq-notevery #'sl:seq-notany))
    (let ((calls 0))
      (let ((answer (funcall fn (lambda (&rest args) (declare (ignore args)) (incf calls) t)
                             (od-fixture) (sl:ordered-dict))))
        (parachute:is eq (not (null (member fn (list #'sl:seq-every #'sl:seq-notany))))
                         (not (null answer)))
        (parachute:is = 0 calls)))))

(parachute:define-test ordered-dict-seq.into-and-join-validation
  ;; INTO/JOIN: explicit target, strict separators and list/lazy escape hatches.
  (od-check '((:a 3) (:b 2))
    (sl:seq-into 'sl:ordered-dict (list (sl:map-entry :a 1) (sl:map-entry :b 2) (sl:map-entry :a 3))))
  (parachute:fail (sl:seq-into 'sl:ordered-dict '(nil)) type-error)
  (parachute:fail (sl:seq-into '(sl:ordered-dict :test eql) nil) program-error)
  (parachute:is equal '(1 2 3 4) (sl:seq-map #'ods-value (sl:seq-into 'list (od-fixture))))
  (let ((calls 0))
    (let ((r (sl:seq-map (lambda (e) (incf calls) (ods-value e))
                         (sl:seq-into 'sl:lazy-seq (od-fixture)))))
      (parachute:is = 0 calls)
      (parachute:is equal '(1 2 3 4) (od-items r))
      (parachute:is = 4 calls)))
  (let ((pieces (list (sl:ordered-dict :a 1) (sl:ordered-dict :b 2 :a 3))))
    (od-check '((:a 3) (:separator 0) (:b 2))
      (sl:seq-join 'sl:ordered-dict pieces :separator (list (sl:map-entry :separator 0))))
    (parachute:fail (sl:seq-join 'sl:ordered-dict pieces :separator '(nil)) type-error)
    (od-check '((:a 1)) (sl:seq-join 'sl:ordered-dict (list (first pieces)) :separator '(nil)))
    (parachute:is equal '((:a 3) (:b 2)) (od-pairs (sl:seq-join 'sl:ordered-dict pieces))))
  (od-check nil (sl:seq-join 'sl:ordered-dict nil))
  (parachute:fail (sl:seq-join '(sl:ordered-dict :unknown t) nil) program-error))

(parachute:define-test ordered-dict-seq.protocol-cross-references-and-projections
  ;; Protocol cross-references: keyed REF vs positional SEQ-REF; lazy projections.
  (let* ((d (sl:ordered-dict 9 :nine 0 nil 1 :one)) (l (sl:dict-size d)))
    (parachute:is eq :nine (sl:ref d 9))
    (parachute:is equal '(nil t) (multiple-value-list (sl:ref d 0)))
    (parachute:is = 9 (sl:entry-key (sl:seq-ref d 0)))
    (parachute:is = 1 (sl:entry-key (sl:seq-ref d -1)))
    (parachute:is = 0 (sl:entry-key (sl:seq-ref d -2)))
    (parachute:is = 9 (sl:entry-key (sl:seq-ref d (- l))))
    (parachute:fail (sl:seq-ref d (- (1+ l))) type-error)
    (parachute:is equal '(nil nil)
                        (multiple-value-list (sl:seq-ref d (- (1+ l)) nil)))
    (parachute:fail (setf (sl:ref d 0) :changed) simple-error)
    (parachute:true (sl:lazy-seq-p (sl:dict-keys d)))
    (parachute:true (sl:lazy-seq-p (sl:dict-vals d)))
    (parachute:is equal '(9 0 1) (od-items (sl:dict-keys d)))
    (parachute:is equal '(:nine nil :one) (od-items (sl:dict-vals d)))
    (parachute:is equal '((9 . :nine) (0) (1 . :one)) (sl:dict-alist d))
    (parachute:is equal '(9 :nine 0 nil 1 :one) (sl:dict-plist d))))

(parachute:define-test ordered-dict-seq.merge-and-transform-order
  ;; Chapter 9 merge/transform preserve encounter order, unlike fixed producers.
  (let ((a (sl:ordered-dict :a 1 :b 2)) (b (sl:ordered-dict :b 20 :c 3)))
    (od-check '((:a 1) (:b 20) (:c 3)) (sl:dict-merge a b))
    (od-check '((:a 10) (:b 20) (:c 3) (:d 4))
      (sl:dict-merge* a b (sl:ordered-dict :a 10 :d 4)))
    (parachute:fail (sl:dict-merge a b :collision :error) program-error)
    (parachute:true (typep (sl:dict-merge a (sl:dict :z 9)) 'sl:dict))
    (od-check '((:a 1) (:b 2)) a))
  (let ((calls nil))
    (od-check '((1 3) (0 4))
      (sl:dict-transform (lambda (k v) (push k calls) (values (mod v 2) v)) (od-fixture)))
    (parachute:is equal '(40 30 20 10) calls))
  (let ((calls nil))
    (parachute:fail
      (sl:dict-transform (lambda (k v) (push k calls) (values :same v))
                         (od-fixture) :collision :error) program-error)
    (parachute:is equal '(20 10) calls))
  (dolist (n '(0 1 3))
    (parachute:fail (sl:dict-transform
                     (lambda (k v) (declare (ignore k v)) (values-list (make-list n)))
                     (od-fixture)) program-error)))

(parachute:define-test ordered-dict-seq.update-and-nested-update
  ;; Ordered positions remain stable on replacement and novel keys append.
  (let ((d (sl:ordered-dict :a nil :b 2)) (calls 0))
    (od-check '((:a :updated) (:b 2))
      (sl:dict-update d :a (lambda (v) (incf calls) (parachute:is eq nil v)
                            (values :updated :ignored)) :default :unused))
    (parachute:is = 1 calls)
    (od-check '((:a nil) (:b 2) (:missing 11))
      (sl:dict-update d :missing (lambda (v) (incf calls) (parachute:is = 10 v) (1+ v))
                      :default 10))
    (parachute:is = 2 calls)
    ;; The removed :SIGNAL keyword is subject to ordinary CL keyword
    ;; checking; ECL's CLOS accepts unknown GF keywords, so the rejection is
    ;; asserted only where the host enforces it.
    (when (dict-unknown-keywords-rejected-p)
      (dolist (obsolete '(nil t))
        (dolist (key '(:a :missing))
          (parachute:fail (funcall #'sl:dict-update d key
                                  (lambda (v) (declare (ignore v)) (incf calls))
                                  :signal obsolete) program-error)
          (parachute:fail (funcall #'sl:dict-update-in d (list key)
                                  (lambda (v) (declare (ignore v)) (incf calls))
                                  :signal obsolete) program-error))))
    (parachute:is = 2 calls)
    (let* ((r (sl:dict-set-in d '(:branch :leaf) nil))
           (child (sl:dict-ref r :branch))
           (updated (sl:dict-update-in r '(:branch :leaf)
                      (lambda (v) (parachute:is eq nil v) :new) :default :unused))
           (created (sl:dict-update-in d '(:branch :middle :leaf) #'1+ :default 40)))
      (parachute:is equal '(:a :b :branch) (od-items (sl:dict-keys r)))
      (parachute:is equal '(:a :b :branch) (od-items (sl:dict-keys updated)))
      (od-check '((:leaf nil)) child)
      (od-check '((:leaf :new)) (sl:dict-ref updated :branch))
      (parachute:is equal '(nil t) (multiple-value-list (sl:dict-ref-in r '(:branch :leaf))))
      (parachute:is equal '(:a :b :branch) (od-items (sl:dict-keys created)))
      (parachute:true (sl:ordered-dict-p (sl:dict-ref created :branch)))
      (od-check '((:leaf 41)) (sl:dict-ref-in created '(:branch :middle)))
      (parachute:is eq #'sl:equals (sl:dict-test (sl:dict-ref created :branch)))
      (od-check '((:a nil) (:b 2)) d)))
  ;; UPDATE-MODEL-CHILD is shared from the earlier containers/integration.lisp fixture.
  ;; Flat and single-key nested operations have the SAME independent oracle.
  (dolist (empty (list (sl:ordered-dict) (sl:dict) (make-hash-table :test 'equal)
                      (make-instance 'update-model-child)))
    (let ((object (list :object))
          (function (lambda () (error "Default is not a thunk"))))
      (dolist (options (list nil (list :default nil) (list :default 0)
                            (list :default object) (list :default function)))
        (dolist (state '(:absent :nil :value))
          (let* ((source (if (eq state :absent) empty
                            (sl:dict-set empty :key (if (eq state :nil) nil :resident))))
                 (expected (case state (:absent (second options)) (:nil nil) (t :resident))))
            (dolist (nested '(nil t))
              (let* ((calls 0) (argument :unobserved)
                     (results (multiple-value-list
                               (apply (if nested #'sl:dict-update-in #'sl:dict-update)
                                      source (if nested '(:key) :key)
                                      (lambda (old) (incf calls) (setf argument old) old)
                                      options)))
                     (result (first results)))
                (parachute:is = 1 calls)
                (parachute:is eq expected argument)
                (parachute:is = 1 (length results))
                (parachute:is eq expected (sl:dict-ref result :key))
                (parachute:true (nth-value 1 (sl:dict-ref result :key)))
                (parachute:is eq (class-of source) (class-of result))
                (parachute:is eq (sl:dict-test source) (sl:dict-test result)))))))))
  (let* ((old-key (copy-seq "key")) (new-key (copy-seq "key"))
         (d (sl:ordered-dict :first 1 old-key nil :last 3)))
    (dolist (r (list (sl:dict-update d new-key #'identity :default :unused)
                    (sl:dict-update-in d (list new-key) #'identity :default :unused)))
      (od-check '((:first 1) ("key" nil) (:last 3)) r)
      (parachute:is eq new-key (sl:entry-key (sl:seq-ref r 1))))
    (parachute:is eq old-key (sl:entry-key (sl:seq-ref d 1))))
  ;; Mixed existing ancestors retain their own class/test, not the root's.
  (let* ((h (make-hash-table :test 'equal))
         (d (sl:ordered-dict :before 1 :branch (sl:dict :child h) :after 2))
         (r (sl:dict-update-in d '(:branch :child :leaf) #'1+ :default 9))
         (new-h (sl:dict-ref-in r '(:branch :child))))
    (parachute:is equal '(:before :branch :after) (od-items (sl:dict-keys r)))
    (parachute:true (typep (sl:dict-ref r :branch) 'sl:dict))
    (parachute:true (hash-table-p new-h))
    (parachute:is eq 'equal (sl:dict-test new-h))
    (parachute:is = 10 (gethash :leaf new-h))
    (parachute:false (eq h new-h))
    (parachute:is = 0 (hash-table-count h)))
  (let ((d (sl:ordered-dict :branch nil)) (calls 0))
    (parachute:fail
     (sl:dict-update-in d '(:branch :leaf)
                        (lambda (v) (declare (ignore v)) (incf calls)) :default :unused)
     type-error)
    (parachute:is = 0 calls)
    (od-check '((:branch nil)) d))
  (dolist (nested '(nil t))
    (let* ((source (sl:ordered-dict :key nil :retained :value))
           (events nil) (tag (gensym "ORDERED-EXIT-"))
           (function (lambda () (error "DEFAULT is not a thunk"))))
      (flet ((invoke (key callback default)
               (funcall (if nested #'sl:dict-update-in #'sl:dict-update)
                        source (if nested (list key) key) callback :default default)))
        (dolist (key '(:key :missing))
          (let ((result (invoke key (lambda (old)
                                     (parachute:is eq (if (eq key :key) nil function) old)
                                     (push :callback events) (values))
                                (progn (push :default events) function))))
            (parachute:is equal '(:callback :default) events)
            (setf events nil)
            (parachute:is equal '(nil t) (multiple-value-list (sl:dict-ref result key))))
          (parachute:is eq :escaped
            (catch tag
              (invoke key (lambda (old) (declare (ignore old))
                            (push :effect events) (throw tag :escaped)) function)
              :returned))
          (parachute:is equal '(:effect) events)
          (setf events nil))
        (od-check '((:key nil) (:retained :value)) source)))))

(parachute:define-test ordered-dict-seq.fixed-result-producer-types
  ;; Fixed-result producers never infer ordered output from ordered inputs.
  (let* ((d (od-fixture)) (calls 0)
         (groups (sl:dict-group-by (lambda (e) (incf calls) (mod (ods-value e) 2)) d))
         (frequencies (sl:dict-frequencies d))
         (zipped (sl:dict-zipmap d '(11 22))))
    (parachute:is = 4 calls)
    (dolist (r (list groups frequencies zipped
                    (sl:alist-dict '((:a . 1))) (sl:plist-dict '(:a 1))))
      (parachute:true (typep r 'sl:dict))
      (parachute:false (sl:ordered-dict-p r)))
    (parachute:is equal '((10 1) (30 3)) (od-pairs (sl:dict-ref groups 1)))
    (parachute:is = 1 (sl:dict-ref frequencies (sl:map-entry 20 2)))
    (parachute:is = 22 (sl:dict-ref zipped (sl:map-entry 20 2))))
  (parachute:true (typep (sl:set-union (od-fixture) (sl:ordered-dict)) 'sl:hash-set)))

(defvar *claim-census-ordered-branch-calls* nil)
(defvar *claim-census-ordered-left-rotations* nil)
(defvar *claim-census-ordered-right-rotations* nil)

(defun claim-census-intercept-target () :original)
(defun claim-census-intercept-caller () (claim-census-intercept-target))

(defun claim-census-symbol-interception-p ()
  "Whether replacing a global function's SYMBOL-FUNCTION is observed by
other compiled code. ECL's compiler links global DEFUN calls directly, so
the branch/rotation census instrumentation is invisible there."
  (let ((original (symbol-function 'claim-census-intercept-target)))
    (unwind-protect
         (progn
           (setf (symbol-function 'claim-census-intercept-target)
                 (lambda () :replaced))
           (eq :replaced (claim-census-intercept-caller)))
      (setf (symbol-function 'claim-census-intercept-target) original))))

(defun claim-census-with-ordered-tree-work (thunk)
  (let* ((branch-name 'sophie-lisp.internal::ordered-branch)
         (left-name 'sophie-lisp.internal::ordered-rotate-left)
         (right-name 'sophie-lisp.internal::ordered-rotate-right)
         (original-branch (symbol-function branch-name))
         (original-left (symbol-function left-name))
         (original-right (symbol-function right-name))
         (*claim-census-ordered-branch-calls* 0)
         (*claim-census-ordered-left-rotations* 0)
         (*claim-census-ordered-right-rotations* 0))
    (unwind-protect
         (progn
           (setf (symbol-function branch-name)
                 (lambda (ordinal entry left right)
                   (incf *claim-census-ordered-branch-calls*)
                   (funcall original-branch ordinal entry left right))
                 (symbol-function left-name)
                 (lambda (node)
                   (incf *claim-census-ordered-left-rotations*)
                   (funcall original-left node))
                 (symbol-function right-name)
                 (lambda (node)
                   (incf *claim-census-ordered-right-rotations*)
                   (funcall original-right node)))
           (funcall thunk))
      (setf (symbol-function branch-name) original-branch
            (symbol-function left-name) original-left
            (symbol-function right-name) original-right))))

(defun claim-census-ordered-tree-shape (node)
  (if (null node)
      (values 0 0 nil nil)
      (multiple-value-bind (left-count left-height left-minimum left-maximum)
          (claim-census-ordered-tree-shape
           (sophie-lisp.internal::ordered-node-left node))
        (multiple-value-bind (right-count right-height right-minimum right-maximum)
            (claim-census-ordered-tree-shape
             (sophie-lisp.internal::ordered-node-right node))
          (let* ((ordinal (sophie-lisp.internal::ordered-node-ordinal node))
                 (height (1+ (max left-height right-height))))
            (parachute:is = height
                          (sophie-lisp.internal::ordered-node-height node))
            (parachute:true (<= (abs (- left-height right-height)) 1))
            (when left-maximum
              (parachute:true (< left-maximum ordinal)))
            (when right-minimum
              (parachute:true (< ordinal right-minimum)))
            (values (+ 1 left-count right-count)
                    height
                    (or left-minimum ordinal)
                    (or right-maximum ordinal)))))))

(defun claim-census-ordered-dictionary-for-order (order)
  (loop with dictionary = (sl:ordered-dict)
        for key in order
        do (setf dictionary (sl:dict-set dictionary key key))
        finally (return dictionary)))

(parachute:define-test claim-census.ordered-dict-avl-invariants-after-adversarial-updates
  (let* ((size 127)
         (orders (list (loop for key below size collect key)
                       (loop for key downfrom (1- size) to 0 collect key)
                       (loop for index below size collect (mod (* index 53) size)))))
    (dolist (order orders)
      (let ((dictionary (claim-census-ordered-dictionary-for-order order)))
        (multiple-value-bind (node-count height)
            (claim-census-ordered-tree-shape
             (sophie-lisp.internal::ordered-dict-order-root dictionary))
          (parachute:is = size node-count)
          (parachute:is = size (sl:dict-size dictionary))
          (parachute:true (<= height (* 1.44d0 (log (+ size 2) 2d0)))))
        ;; Removing alternating insertion positions exercises AVL deletion repairs.
        (loop for position from 0 below size by 2
              for key = (nth position order)
              do (setf dictionary (sl:dict-without dictionary key)))
        (multiple-value-bind (node-count height)
            (claim-census-ordered-tree-shape
             (sophie-lisp.internal::ordered-dict-order-root dictionary))
          (parachute:is = (sl:dict-size dictionary) node-count)
          (parachute:is = (floor size 2) node-count)
          (parachute:true (<= height (* 1.44d0 (log (+ node-count 2) 2d0)))))))))

(parachute:define-test claim-census.ordered-dict-bulk-build-allocates-nodes-without-rotations
  (let ((size 257))
    (claim-census-with-ordered-tree-work
     (lambda ()
       (let ((dictionary
               (apply #'sl:ordered-dict
                      (loop for key below size append (list key key)))))
         ;; The census counts calls through the replaced SYMBOL-FUNCTIONs;
         ;; ECL's compiler links global DEFUN calls directly, so the counts
         ;; are asserted only where the interception is observable.
         (when (claim-census-symbol-interception-p)
           (parachute:is = size *claim-census-ordered-branch-calls*)
           (parachute:is = 0 *claim-census-ordered-left-rotations*)
           (parachute:is = 0 *claim-census-ordered-right-rotations*))
         (multiple-value-bind (node-count height)
             (claim-census-ordered-tree-shape
              (sophie-lisp.internal::ordered-dict-order-root dictionary))
           (parachute:is = size node-count)
           (parachute:is = size (sl:dict-size dictionary))
           (parachute:true (<= height (* 1.44d0 (log (+ size 2) 2d0))))))))))
